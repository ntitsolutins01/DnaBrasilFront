@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}



<header>
    <link rel="stylesheet" href="~/assets/logout/logout.css" />

    
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <div id="conteiner">
                <img src="~/assets/logout/dna.svg" id="logo" alt="logo da empresa" />
            </div>
            <div id="icone-conteiner">
                <img src="~/assets/logout/logout.svg" id="icone" alt="Ícone de logout" />
                <div>
                    <h1 id="texto-menusuperior">Realizar Logout</h1>
                    <p id="texto-menuinferior">
                        Clique no Botão para ser Deslogado Imediatamente.
                    </p>
                </div>
                <div id="area-botao">
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" id="botao" class="nav-link btn btn-link text-dark">Click here to Logout</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div id="conteiner">
                <img src="~/assets/logout/dna.svg" id="logo" alt="logo da empresa" />
            </div>
            <div id="icone-conteiner">
                <img src="~/assets/logout/logout.svg" id="icone" alt="Ícone de logout" />
                <div>
                    <h1 id="texto-menusuperior">Sessão encerrada</h1>
                    <p id="texto-menuinferior">
                        Sua sessão foi encerrada com sucesso. Obrigado por usar nossos
                        serviços!
                    </p>
                </div>
                <div id="area-botao">
                    <button id="botao">Voltar à Página Inicial</button>
                </div>
            </div>
        }
    }
</header>

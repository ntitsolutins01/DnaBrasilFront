@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrar";
}

<section class="body-sign" id="vRegister">
    <div class="center-sign">
        <a href="/" class="logo pull-left">
            <img src="~/assets/images/logo.png" height="94" alt="Dna do Brasil" />
        </a>

        <div class="panel panel-sign">
            <div class="panel-title-sign mt-xl text-right">
                <h2 class="title text-uppercase text-weight-bold m-none"><i class="fa fa-user mr-xs"></i> Registrar</h2>
            </div>
            <div class="panel-body">
                <form asp-route-returnUrl="@Model.ReturnUrl" method="post" id="formRegister">
                    @if (Request.HasFormContentType)
                    {
                        <div asp-validation-summary="All" class="alert alert-mini alert-danger margin-bottom-30"></div>
                    }
                    <div class="form-group mb-lg">
                        <label>NOME CIVIL</label><span class="required">*</span>
                        <input name="nome" id="nome" type="text" class="form-control" required placeholder="Ex: JOÃO CARLOS  ALVES DA SILVA"
                               title="Por favor informe o nome completo." maxlength="300" oninput="this.value = this.value.toUpperCase()" />
                        <p>
                            <code>Sem abreviações</code>
                        </p>
                    </div>
                    <div class="form-group mb-lg">
                        <label>COMO VOCÊ QUER SER CHAMADO?</label>
                        <input name="apelido" id="apelido" type="text" class="form-control" placeholder="Ex: JOCA"
                               title="Por favor informe o apelido." maxlength="50" oninput="this.value = this.value.toUpperCase()" />
                    </div>
                    <div class="form-group mb-lg">
                        <label>CPF</label>
                        <input name="cpf" id="cpf" type="text" class="form-control" placeholder="Ex: 222.222.222-22"
                               title="Por favor informe o cpf." />
                    </div>
                    <div class="form-group mb-lg">
                        <label>DATA DE NASCIMENTO</label><span class="required">*</span>
                        <input id="dtNasc" name="dtNasc"
                               required
                               title="Por favor informe a data de nascimento."
                               style="z-index: auto;"
                               data-plugin-datepicker data-date-format="dd/mm/yyyy" data-plugin-options='{"language": "pt-BR"}'
                               placeholder="__/__/____" class="form-control startdate"
                               class="form-control">
                    </div>
                    <div class="form-group mb-lg">
                        <label>SEXO</label><span class="required">*</span>
                        <select class="form-control populate select2" name="ddlSexo" id="ddlSexo"
                                title="Por favor selecione um sexo." required>
                            <option value="">Selecionar Sexo</option>
                            <option value="M">MASCULINO</option>
                            <option value="F">FEMININO</option>
                        </select>
                    </div>
                    <div class="form-group mb-lg">
                        <label>COR OU RAÇA</label><span class="required">*</span>
                        <select class="form-control populate select2" name="ddlEtnia" id="ddlEtnia" style="width:100%"
                                title="Por favor selecione um raça/cor." required
                                asp-for="EtniaId" asp-items="Model.ListEtnias">
                            <option value="">Selecionar cor ou raça</option>
                        </select>
                    </div>
                    <div class="form-group mb-lg">
                        <label>ESTADO</label><span class="required">*</span>
                        <select class="form-control populate select2" name="ddlEstado" id="ddlEstado"
                                title="Por favor informe um Estado." required
                                asp-for="EstadoId" asp-items="Model.ListEstados">
                            <option value="">Selecionar Estado</option>
                        </select>
                    </div>
                    <div class="form-group mb-lg">
                        <label>MUNICÍPIO</label><span class="required">*</span>
                        <select class="form-control populate select2" name="ddlMunicipio" id="ddlMunicipio"
                                title="Por favor informe um Município." required
                                asp-for="MunicipioId" asp-items="Model.ListMunicipios">
                            <option value="">Selecionar Município</option>
                        </select>
                    </div>
                    <div class="form-group mb-lg">
                        <label>ENDEREÇO</label>
                        <input name="endereco" id="endereco" type="text" class="form-control" placeholder="Ex: rua xxx, quadra xxxx, lote xxxx"
                               title="Por favor informe o endereço." maxlength="400" oninput="this.value = this.value.toUpperCase()" />
                    </div>
                    <div class="form-group mb-lg">
                        <label>BAIRRO</label>
                        <input name="bairro" id="bairro" type="text" class="form-control" placeholder="Ex: Setor Nova Olinda"
                               title="Por favor informe o bairro." maxlength="200" oninput="this.value = this.value.toUpperCase()" />
                    </div>
                    <div class="form-group mb-lg">
                        <label>CEP</label>
                        <input name="cep" id="cep" type="text" class="form-control" placeholder="Ex: 22222.222"
                               title="Por favor informe o bairro." maxlength="9" oninput="this.value = this.value.toUpperCase()" />
                    </div>
                    <div class="form-group mb-lg">
                        <label>TELEFONE PARA CONTATO</label><span class="required">*</span>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-phone"></i>
                            </span>
                            <input id="numTelefone" name="numTelefone" class="form-control"
                                   maxlength="14" required title="Por favor informe o telefone para contato.">
                        </div>
                    </div>
                    <div class="form-group mb-lg">
                        <label>E-MAIL</label><span class="required">*</span>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-envelope"></i>
                            </span>
                            <input type="text" name="email" maxlength="100" class="form-control"
                                   required title="Por favor informe o email." oninput="this.value = this.value.toLowerCase()" />
                        </div>
                    </div>
                    <div class="form-group mb-lg">
                        <label>Possui alguma deficiência ou condição que requeira atendimento especializado?</label>
                        <select class="form-control populate select2" name="ddlDeficiencia" id="ddlDeficiencia" style="width:100%"
                                title="Por favor selecione uma deficiência." required
                                asp-for="DeficienciaId" asp-items="Model.ListDeficiencia">
                            <option value="">Selecionar Deficiência</option>
                        </select>
                    </div>

                    <div class="form-group mb-lg">
                        <p><span class="highlight">DADOS DO RESPONSÁVEL</span></p>
                        <label>NOME COMPLETO</label><span class="required">*</span>
                        <input name="nomeResponsavel" id="nomeResponsavel" type="text" class="form-control" required placeholder="Ex: JOÃO CARLOS  ALVES DA SILVA"
                               title="Por favor informe o nome completo do responsável." maxlength="200" oninput="this.value = this.value.toLowerCase()" />
                    </div>

                    <div class="form-group mb-lg">
                        <label>CPF</label><span class="required">*</span>
                        <input name="cpfResponsavel" id="cpfResponsavel" type="text" class="form-control" placeholder="Ex: 222.222.222-22"
                               title="Por favor informe o cpf do responsável." required/>
                    </div>

                    <div class="form-group mb-lg">
                        <label>GRAU DE PARENTESCO</label><span class="required">*</span>
                        <select class="form-control populate select2" name="ddlGrauParentesco" id="ddlGrauParentesco" style="width:100%"
                                title="Por favor selecione um grau de parentêsco." required
                                asp-for="GrauParentescoId" asp-items="Model.ListGrauParentescos">
                            <option value="">Selecionar Grau de Parentesco</option>
                        </select>
                    </div>
                    <div class="form-group mb-lg">
                        <label>TELEFONE PARA CONTATO</label><span class="required">*</span>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-phone"></i>
                            </span>
                            <input id="numTelefoneResponsavel" name="numTelefoneResponsavel" class="form-control"
                                   maxlength="14" required title="Por favor informe o telefone para contato.">
                        </div>
                    </div>
                    <div class="form-group mb-lg">
                        <label>E-MAIL</label>
                        <div class="input-group">
                            <span class="input-group-addon">
                                <i class="fa fa-envelope"></i>
                            </span>
                            <input type="text" id="emailResponsavel" name="emailResponsavel" maxlength="100" class="form-control"
                                   title="Por favor informe o email." oninput="this.value = this.value.toLowerCase()" />
                        </div>
                    </div>

                    <div class="form-group mb-lg">
                        <div class="checkbox-custom checkbox-default">
                            <input id="AgreeTerms" id="agreeterms" name="agreeterms" type="checkbox" required title="Por favor leia com atenção para aceitar ao termo." />
                            <label for="AgreeTerms">Declaro, como responsável legal, estar ciente e de acordo com a participação do(a) menor nas atividades do Projeto, autorizando a inscrição nesta etapa inicial. Comprometo-me a comparecer presencialmente para entrega da documentação e finalização da matrícula.</label>
                            <span class="required">*</span>
                        </div>
                        <label class="error" for="agreeterms"></label>
                    </div>

                    <div class="form-group mb-lg">
                        <label>UNIDADE DE INTERESSE</label><span class="required">*</span>
                        <select class="form-control populate select2" name="ddlLocalidade" id="ddlLocalidade"
                                title="Por favor informe a unidade de interesse." required=""
                                asp-for="LocalidadeId" asp-items="Model.ListLocalidades">
                            <option value="">Selecionar a unidade de interesse</option>
                        </select>
                    </div>

                    <div class="form-group mb-lg">
                        <p>
                            <code><b>Atenção</b>: Anote o número de inscrição gerado ao final do formulário. Compareça ao centro escolhido para confirmar sua matrícula, levando os seguintes documentos: Comprovante de residência; RG e CPF do aluno e do responsável; Laudo médico (no caso de Pessoas com Deficiência – PcD).</code>
                        </p>
                    </div>
                    <div class="row">
                        <div class="col-sm-8">
                        </div>
                        <div class="col-sm-4 text-right">
                            <button type="submit" class="btn btn-primary hidden-xs">Registrar</button>
                            <button type="submit" class="btn btn-primary btn-block btn-lg visible-xs mt-lg">Registrar</button>
                        </div>
                    </div>

                </form>
            </div>
        </div>

        <p class="text-center text-muted mt-md mb-md">&copy; Copyright 2024. Todos os direitos reservados.</p>
    </div>
</section>

@section Scripts {
    <script src="~/js/register.js"></script>
    <script>

        (function ($) {

            'use strict';

            var notify = @Model.NotifyMessage;
            var messagem = '@Model.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'Aluno',
                    text: messagem,
                    type: 'success'
                });
            } else if (notify === 1) {
                new PNotify({
                    title: 'Aluno',
                    text: messagem,
                    type: 'warning'
                });
            } else if (notify === 2) {
                new PNotify({
                    title: 'Aluno',
                    text: messagem,
                    type: 'error'
                });
            }


        }).apply(this, [jQuery]);
    </script>
}

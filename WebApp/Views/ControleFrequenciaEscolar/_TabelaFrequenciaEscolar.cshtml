@using Microsoft.IdentityModel.Tokens
@model ControleFrequenciaEscolarModel.TabelaFrequenciasEscolares

<section class="panel">
	<header class="panel-heading">
		<div class="panel-actions">
			<a href="#" class="card-action card-action-toggle" data-card-toggle></a>
		</div>
		<h2 class="panel-title">Listagem de Frequências</h2>
	</header>
	<div class="panel-body">
		@using (@Html.BeginForm("Create", "ControleFrequenciaEscolar", FormMethod.Post, new { id = "formCreateFrequenciaEscolar", @class = "form-horizontal" }))
		{
			<div class="form-group row">
				<div class="col-sm-2 pull-right" style="margin-top: 29px;">
					<button type="submit" id="addToTable" class="btn btn-block btn-success pull-right"><i class="fa fa-save"></i> Salvar Frequências </button>
				</div>
				<div class="col-sm-4 pull-right" style="margin-top: 29px;">
					<div class="alert alert-danger" style="padding-bottom: 6px;padding-top: 6px; !important; margin-bottom: 0px; !important">
						Clique no checkbox para<strong> marcação de FALTAS</strong>.
					</div>
				</div>
				<div class="col-sm-3">
					<label class="control-label">Profissional:</label>
					<select class="form-control populate select2"
					        required title="Por favor selecione o profissional"
					        name="ddlProfissional" id="ddlProfissional"
					        asp-for="ProfissionalId" asp-items="Model.ListProfissionais"
					        style="width:100%" data-plugin-options='{"width":"100%"}'>
						<option value="">Selecionar Profissional</option>
					</select>
				</div>
				<div class="col-sm-3">
					<label class="control-label">Disciplina:</label>
					<select class="form-control populate select2"
					        required title="Por favor selecione a disciplina"
					        name="ddlDisciplina" id="ddlDisciplina"
					        asp-for="DisciplinaId" asp-items="Model.ListDisciplinas"
					        style="width:100%" data-plugin-options='{"width":"100%"}'>
						<option value="">Selecionar Disciplina</option>
					</select>
				</div>
			</div>
			<table class="table table-bordered table-striped mb-0" id="datatable-default">
				<thead>
					<tr>
						<th class="text-center">Matricula - Nome do Aluno</th>
						@{
							DateTime dataAtual = DateTime.Now;
							int ano = dataAtual.Year;
							int mes = dataAtual.Month;
							int totalDiasNoMes = DateTime.DaysInMonth(ano, mes);
							int diaHoje = dataAtual.Day;

							for (int dia = 1; dia <= totalDiasNoMes; dia++)
							{
								<th class="text-center">@dia</th>
							}
						}
						<th class="text-center">Ação</th>
					</tr>
				</thead>
				<tbody>
					@if (!Model.Alunos.IsNullOrEmpty())
					{
						foreach (var aluno in Model.Alunos)
						{
							<tr>
								<td class="text-center" style="width: 300px;">
									@aluno.Nome
								</td>

								@for (int dia1 = 1; dia1 <= totalDiasNoMes; dia1++)
								{
									var disabled = dia1 != diaHoje ? "disabled" : "";
									var isHoje = dia1 == diaHoje ? "checkbox-dia-hoje" : "";

									var temPresenca = Model.AlunosComPresencas != null && Model.AlunosComPresencas.Any(p =>
									p.AlunoId == aluno.Id.ToString() &&
									ParseDate(p.DataFrequencia).Date == new DateTime(ano, mes, dia1) &&
									p.Controle == "P"
									);

									@functions {

						public static DateTime ParseDate(object data)
						{
							if (data is DateTime dt)
								return dt;
							if (data is string s)
								return DateTime.Parse(s);
							return DateTime.MinValue;
						}

					}

									var marcado = temPresenca ? "checked" : "";

									<th class="text-center">
										<input type="checkbox"
											   id="F-@aluno.Id"
											   name="F-@aluno.Id"
											   class="@isHoje"
											   data-aluno-id="@aluno.Id"
											   data-dia="@dia1"
										@disabled @marcado />
									</th>
								}
								<td class="actions text-center" style="width: 100px;">
									<a href="#" data-id="@aluno.Id" data-toggle="modal" data-target="#mdEditControleFrequencia"
									   data-toggle="tooltip" data-placement="top" title="Editar Frequência"
									   class="on-default edit-row" style='color: #FF9800'><i class="fa fa-pencil"></i></a>
								</td>

							</tr>
						}
					}
				</tbody>
			</table>
		}
		<!-- Modal -->
		<div class="modal fade" id="mdEditControleFrequencia" tabindex="-1" role="dialog" aria-labelledby="mdEditControleFrequenciaLabel" aria-hidden="true">
			<div class="modal-dialog modal-md" role="document">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="mdEditControleFrequenciaLabel">
							<i class="fa fa-pencil"></i> &nbsp;&nbsp;<strong>Alterar Frequência</strong>
						</h5>
					</div>
					@using (@Html.BeginForm("Edit", "ControleFrequenciaEscolar", FormMethod.Post, new { id = "formEditControleFrequencia", @class = "form-horizontal" }))
					{
						<input type="hidden" name="editControleFrequenciaId" :value="editDto.Id" />
						<input type="hidden" name="editAlunoId" :value="editDto.AlunoId" />

						<div class="modal-body">

							<div class="form-group">
								<label class="col-sm-3 control-label text-sm-right pt-2">Aluno <span class="required">*</span></label>
								<div class="col-md-9">
									<input type="text" name="aluno" class="form-control" :value="editDto.NomeAluno" readonly />
								</div>
							</div>
							<div class="form-group row">
								<label class="col-sm-3 control-label">Data: <span class="required">*</span></label>
								<div class="col-sm-4 form-group">
									<div class="input-group">
										<span class="input-group-addon">
											<i class="fa fa-calendar"></i>
										</span>
										<input id="data" name="data"
											   required
											   title="Por favor informe a data."
											   style="z-index: auto;"
											   data-plugin-datepicker data-date-format="dd/mm/yyyy" data-plugin-options='{"language": "pt-BR"}'
											   placeholder="__/__/____" class="form-control startdate"
											   class="form-control">
									</div>
								</div>
							</div>
							<div class="form-group row">
								<label class="col-sm-3 control-label text-sm-right pt-2">Controle <span class="required">*</span></label>
								<div class="col-sm-4">
									<div class="radio-custom radio-success">
										<input type="radio" id="controlePresente" name="controle" value="P" required title="Por favor selecione uma opção" :checked="editDto.Controle === 'P'">
										<label>Presente</label>
									</div>
									<div class="radio-custom radio-danger">
										<input type="radio" id="controleFalta" name="controle" value="F" required title="Por favor selecione uma opção" :checked="editDto.Controle === 'F'">
										<label>Falta</label>
									</div>
								</div>
							</div>
						</div>
						<div class="modal-footer">
							<button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
							<button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>
<link rel="stylesheet" href="~/assets/vendor/datatables/media/css/dataTables.bootstrap4.css" />
<script src="~/assets/vendor/datatables/media/js/jquery.dataTables.min.js"></script>
<script src="~/assets/vendor/datatables/media/js/dataTables.bootstrap4.min.js"></script>
<script src="~/js/formatTableMultiselect.js"></script>

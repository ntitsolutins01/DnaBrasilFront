@model WebApp.Models.AulaModel
@{
	ViewData["Title"] = "Listagem de Aulas";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="vAula">
	<div class="row">
		<div class="col-lg-12">
			<section class="panel">
				<header class="panel-heading">
					<div class="panel-actions">
						<a href="#" class="card-action card-action-toggle" data-card-toggle></a>
					</div>
					<h2 class="panel-title">Listagem de Aulas</h2>
				</header>
				<div class="panel-body">
					<div class="form-group row">
						<div class="col-sm-12 pull-right">
							<a href="@Url.Action("Create", "Aula")" id="addToTable" class="btn btn-primary pull-right"><i class="fa fa-plus"></i>&nbsp;&nbsp;Nova Aula </a>
						</div>
					</div>
					<table class="table table-bordered table-striped mb-0" id="datatable-default">
						<thead>
							<tr>
								<th class="text-center">Id</th>
								<th class="text-center">Curso</th>
								<th class="text-center">Modulo</th>
								<th class="text-center">Titulo</th>
								<th class="text-center">Descrição</th>
								<th class="text-center">Status</th>
								<th class="text-center">Ações</th>
							</tr>
						</thead>
                        <tbody>
                        @foreach (var item in Model.Aulas)
							{ 
								<tr>
									<td class="actions text-center" style="width:20px;">@Html.DisplayFor(modelItem => item.Id)</td>
									<td class="actions text-center" style="width:250px;">@Html.DisplayFor(modelItem => item.NomeCurso)</td>
									<td class="actions text-center">@Html.DisplayFor(modelItem => item.TituloModuloEad)</td>
									<td class="actions text-center">@Html.DisplayFor(modelItem => item.Titulo)</td>
									<td class="actions text-center">@Html.DisplayFor(modelItem => item.Descricao)</td>
									@if (item.Status)
									{
										<td class="actions text-center"><span class="label label-success">ATIVO</span></td>
									}
									else
									{
										<td class="actions text-center"><span class="label label-danger">INATIVO</span></td>
									}
									<td class="actions text-center" style="width:100px;">
										@* <a data-toggle="tooltip" data-placement="top" title="Visualizar Vídeo" href='javascript:(crud.VisualizarVideoModal(@item.Id))'
										   class="on-default info-row" style="cursor: pointer;color: #7B1FA2"><i class="fa fa-film"></i></a> *@
										
										<a href="#" data-id="@item.Id" data-toggle="modal" data-target="#mdUpload"
										   data-toggle="tooltip" data-placement="top" title="Upload Vídeo"
										   class="on-default edit-row" style='color: #303F9F'><i class="fa fa-upload"></i></a>

										<a data-toggle="tooltip" data-placement="top" title="Editar"
										   href='javascript:(crud.EditModal(@item.Id))'
										   class="on-default edit-row" style='color: #FF9800'>
											<i class="fa fa-pencil"></i>
										</a>
										<a data-toggle="tooltip" data-placement="top" title="Excluir" href='javascript:(crud.DeleteModal(@item.Id))'
										   class="on-default remove-row" style="cursor: pointer; color: #F44336"><i class="fa fa-trash"></i></a>
									</td>
								</tr>
								}
                        </tbody>
					</table>
				</div>
			</section>
		</div>
	</div>
	<!-- Modal -->
	<div class="modal fade" id="mdDeleteAula" tabindex="-1" role="dialog" aria-labelledby="mdDeleteAulaLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="mdDeleteAulaLabel">
						<i class="fa fa-trash"></i> &nbsp;&nbsp;<strong>Exclusão de Aula</strong>
					</h5>
				</div>
				<div class="modal-body">
					<div class="modal-icon">
						<i class="fa fa-question-circle"></i>
					</div>
					<div class="modal-text">
						<input type="hidden" id="deleteAulaId" />
						<p class="mb-0">Tem certeza que deseja <b>excluir</b> esse registro?</p>
					</div>
					<div class="modal-wrapper">
					</div>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-thumbs-o-down"></i> &nbsp;&nbsp;Não</button>
					<a id="deleteAulaHref" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-thumbs-o-up"></i> &nbsp;&nbsp;Sim</a>
				</div>
			</div>
		</div>
	</div>
	<!-- Modal -->
	<div class="modal fade" id="mdEditAula" tabindex="-1" role="dialog" aria-labelledby="mdEditAulaLabel" aria-hidden="true">
		<div class="modal-dialog modal-md" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="mdEditAulaLabel">
						<i class="fa fa-pencil"></i> &nbsp;&nbsp;<strong>Alterar Aula</strong>
					</h5>
				</div>
				@using (@Html.BeginForm("Edit", "Aula", FormMethod.Post, new { id = "formEditAula", @class = "form-horizontal", @enctype = "multipart/form-data" }))
				{
					<div class="modal-body">
						<input type="hidden" name="editAulaId" :value="editDto.Id"/>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Professor <span class="required">*</span></label>
							<div class="col-sm-9">
								<select class="form-control populate select2" name="ddlProfessor" id="ddlProfessor" style="width:100%"
								        required title="Por favor selecione o professor">
									<option value="">Selecionar Professor</option>
								</select>
							</div>
						</div>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Titulo da Aula: <span class="required">*</span></label>
							<div class="col-sm-9">
								<input type="text" name="nome" :value="editDto.Titulo" class="form-control"
								       maxlength="250"
								       title="Por favor informe o nome do curso." required/>
							</div>
						</div>
						<div class="form-group">
							<label class="col-sm-3 control-label text-sm-right pt-2">Descrição: </label>
							<div class="col-sm-9">
								<textarea class="form-control" rows="7" maxlength="500" name="descricao" v-model="editDto.Descricao" id="descricao"></textarea>
							</div>
						</div>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Nome Video: <span class="required">*</span></label>
							<div class="col-sm-9">
								<input type="text" name="nomeVideo" :value="editDto.NomeVideo" class="form-control"
									   maxlength="1000" placeholder="eg.: file path"
									   title="Por favor informe o nome do vídeo."  />
							</div>
						</div>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Video: <span class="required">*</span></label>
							<div class="col-sm-9">
								<input type="text" name="video" :value="editDto.Video" class="form-control"
									   maxlength="1000" placeholder="eg.: file path"
									   title="Por favor informe o file path do vídeo."  />
							</div>
						</div>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Nome do Material Didático: <span class="required">*</span></label>
							<div class="col-sm-9">
								<input type="text" name="nomeMaterial" :value="editDto.NomeMaterial" class="form-control"
									   maxlength="1000" placeholder="eg.: file path"
									   title="Por favor informe o nome do material didático."  />
							</div>
						</div>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Material Didático: <span class="required">*</span></label>
							<div class="col-sm-9">
								<input type="text" name="material" :value="editDto.Material" class="form-control"
									   maxlength="1000" placeholder="eg.: file path"
									   title="Por favor informe o file path do material didático."  />
							</div>
						</div>
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Ordem: <span class="required">*</span></label>
							<div class="col-sm-2">
								<input type="number" name="ordem" class="form-control" maxlength="2" :value="editDto.Ordem"
									   title="Por favor informe a ordem." required oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" />
							</div>
						</div>
						@* <div class="form-group">
							<label class="col-sm-3 control-label">Video</label>
							<div class="col-sm-9">
								<div class="fileupload fileupload-new" data-provides="fileupload">
									<div class="input-append">
										<div class="uneditable-input">
											<i class="fa fa-file fileupload-exists"></i>
											<span class="fileupload-preview">{{ editDto.NomeMaterial }}</span>
										</div>
										<span class="btn btn-default btn-file">
											<span class="fileupload-exists">Alterar</span>
											<span class="fileupload-new">Selecionar Arquivo</span>
											<input type="file" id="video" name="video" />
										</span>
										<a href="#" class="btn btn-default fileupload-exists" data-dismiss="fileupload">Remover</a>
									</div>
									<div v-if="editDto.NomeMaterial" class="mt-2">
										<code>Material Didático atual: {{ editDto.NomeMaterial }}</code>
									</div>
								</div>
							</div>
							<label class="col-sm-3 control-label">Material Didático</label>
							<div class="col-sm-9">
								<div class="fileupload fileupload-new" data-provides="fileupload">
									<div class="input-append">
										<div class="uneditable-input">
											<i class="fa fa-file fileupload-exists"></i>
											<span class="fileupload-preview">{{ editDto.NomeVideo }}</span>
										</div>
										<span class="btn btn-default btn-file">
											<span class="fileupload-exists">Alterar</span>
											<span class="fileupload-new">Selecionar Arquivo</span>
											<input type="file" id="arquivo" name="arquivo"/>
										</span>
										<a href="#" class="btn btn-default fileupload-exists" data-dismiss="fileupload">Remover</a>
									</div>
									<div v-if="editDto.NomeMaterial" class="mt-2">
										<code>Material Didático atual: {{ editDto.NomeMaterial }}</code>
									</div>
								</div>
							</div>
						</div> *@
						<div class="form-group row">
							<label class="col-sm-3 control-label text-sm-right pt-2">Status</label>
							<div class="col-md-9">
								<div class="switch switch-sm switch-primary">
									<div v-show="editDto.Status">
										<input type="checkbox" id="editStatus" name="editStatus" data-plugin-ios-switch checked="checked"/>
									</div>
									<div v-show="!editDto.Status">
										<input type="checkbox" id="editStatus" name="editStatus" data-plugin-ios-switch/>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
						<button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
					</div>
				}
			</div>
		</div>
	</div>
	<!-- Modal -->
	<div class="modal fade" id="mdUpload" tabindex="-1" role="dialog" aria-labelledby="mdUploadLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="mdUploadLabel">
						<i class="fa fa-upload"></i> &nbsp;&nbsp;<strong>Upload Video</strong>
					</h5>
				</div>
				@using (@Html.BeginForm("Upload", "Aula", FormMethod.Post, new { id = "formUploadVideo", @class = "form-horizontal", @enctype = "multipart/form-data" }))
				{
					<div class="modal-body">
						<input type="hidden" id="aulaId" name="aulaId" />
						<div class="form-group mb-lg">
							<label class="col-sm-2 control-label">Video</label>
							<div class="col-sm-10">
								<div class="fileupload fileupload-new" data-provides="fileupload">
									<div class="input-append">
										<div class="uneditable-input">
											<i class="fa fa-file fileupload-exists"></i>
											<span class="fileupload-preview"></span>
										</div>
										<span class="btn btn-default btn-file">
											<span class="fileupload-exists">Alterar</span>
											<span class="fileupload-new">Selecionar Arquivo</span>
											<input type="file" id="arquivoVideo" name="arquivoVideo" accept=".mp4,.avi" v-on:change="ValidateFileType()" />
										</span>
										<a href="#" class="btn btn-default fileupload-exists" data-dismiss="fileupload">Remover</a>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer">
						<button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Fechar</button>
						<button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
					</div>
				}
			</div>
		</div>
	</div>
</div>

@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-fileupload/bootstrap-fileupload.min.css" />
	<link rel="stylesheet" href="~/assets/vendor/select2/css/select2.css" />
	<link rel="stylesheet" href="~/assets/vendor/select2-bootstrap-theme/select2-bootstrap.min.css" />
	<link rel="stylesheet" href="~/assets/vendor/datatables/media/css/dataTables.bootstrap4.css" />
}
@section Scripts {
    <script src="~/assets/vendor/bootstrap-fileupload/bootstrap-fileupload.min.js"></script>
	<script src="~/assets/vendor/select2/js/select2.js"></script>
	<script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
	<script src="~/assets/vendor/jquery-mask/jquery.mask.js"></script>
	<script src="~/assets/vendor/ios7-switch/ios7-switch.js"></script>
	<script src="~/assets/vendor/datatables/media/js/jquery.dataTables.min.js"></script>
	<script src="~/assets/vendor/datatables/media/js/dataTables.bootstrap4.min.js"></script>
	<script src="~/js/formatTable.js"></script>
	<script src="~/js/Aula.js"></script>

	<script>

		(function ($) {

			'use strict';
			var crud = @ViewBag.CrudMessage;

			if (crud === 1) {
				new PNotify({
					title: 'Aula',
					text: 'Cadastro realizado com sucesso!',
					type: 'success'
				});
				crud = 0;
			} else if (crud === 2) {
				new PNotify({
					title: 'Aula',
					text: 'Dados alterados com sucesso.',
					type: 'warning',
					icon: 'fa fa-pencil'
				});
				crud = 0;
			} else if (crud === 3) {
				new PNotify({
					title: 'Aula',
					text: 'Registro excluído com sucesso.',
					type: 'error',
					icon: 'fa fa-trash-o'
				});
				crud = 0;
			}


			var notify = @ViewBag.NotifyMessage;
			var messagem = '@ViewBag.Notify';

			if (notify === 0) {
				new PNotify({
					title: 'Aula',
					text: messagem,
					type: 'success'
				});
				crud = 0;
			} else if (notify === 1) {
				new PNotify({
					title: 'Aula',
					text: messagem,
					type: 'warning'
				});
				crud = 0;
			} else if (notify === 2) {
				new PNotify({
					title: 'Aula',
					text: messagem,
					type: 'error'
				});
				crud = 0;
			}

			if ($.isFunction($.fn['tooltip'])) {
				$('[data-toggle=tooltip],[rel=tooltip]').tooltip({ container: 'body' });
			}

		}).apply(this, [jQuery]);
	</script>
}




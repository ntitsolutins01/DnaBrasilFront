@model WebApp.Models.LaudoResumidoModel
@using System.Globalization
@using WebApp.Dto
@{
	Layout = null;

	string GetProgressBarWidth(string title, string value)
	{
		if (string.IsNullOrEmpty(value)) return "0%";

		double numValue;
		if (!double.TryParse(value.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out numValue)) return "0%";

		double percentage = 0;
		switch (title)
		{
			case "Impulsão Horizontal":
				percentage = (numValue / 250.0) * 100;
				break;
			case "Preensão Manual":
				percentage = (numValue / 80.0) * 100;
				break;
			case "Flexibilidade":
				percentage = (numValue / 455.0) * 100;
				break;
			case "Índice de Massa Corporal":
				percentage = (numValue / 37.26) * 100;
				percentage = Math.Min(percentage, 100);
				break;
			case "imc":
				percentage = (numValue / 37.26) * 100;
				percentage = Math.Min(percentage, 100);
				break;
			default:
				percentage = 0;
				break;
		}

		return $"{percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%";
	}

	async Task RenderHeaderAsync(string nome, byte[] byteImage)
	{
		<header class="header">
			<img src="~/assets/images/logo2.png" alt="DNA do Brasil" class="logo-dna" />
			<div class="talent-info">
				<div class="text-info">
					<div class="talent-label">MEU TALENTO</div>
					<div class="talent-name">

						<text>@nome</text>
					</div>
				</div>
				<div class="sport-icon"
					 style=" background-size: cover;">
					@{
						var base64 = Convert.ToBase64String(byteImage);
						var imgSrc = String.Format("data:image/gif;base64,{0}", base64);
					}
					<img src="@imgSrc" />
				</div>
			</div>
		</header>
	}

	async Task RenderStudentInfoAsync(byte[]? byteImageFotoAluno, string nomeAluno, string nomeLocalidade, string email, int idade, string etnia,
									string nomeDeficiencia, string dtNascimento)
	{
		<div class="left-section">
			<div class="student-info">
				<div class="student-photo">
					@if (byteImageFotoAluno != null)
					{
						var imgSrc = $"data:image/gif;base64,{Convert.ToBase64String(byteImageFotoAluno)}";
						<img src="@imgSrc" alt="Foto do aluno" />
					}
					else
					{
						<img src="/assets/images/user.png" alt="Foto padrão" />
					}
				</div>
				<div class="student-basic-info">
					<div class="student-name">@nomeAluno</div>
					<div class="student-school">@nomeLocalidade</div>
					<div class="student-email">@email</div>
				</div>
			</div>
			<div class="student-details">
				<div class="student-extra-grid">
					<div class="detail-row">
						<div><span class="info-label">Idade:</span> @idade</div>
						<div><span class="info-label">Série:</span> Não definida</div>
					</div>
					<div class="detail-row">
						<div><span class="info-label">Raça/Cor:</span> @etnia</div>
						<div><span class="info-label">Deficiência:</span> @nomeDeficiencia</div>
					</div>
                    <div class="detail-row">
                        <div><span class="info-label">Data de Nascimento:</span> @dtNascimento</div>
                    </div>
                    <div class="detail-row">
                        <div><span class="info-label">Data do Laudo:</span> {dataCriacao} / Laudo #{ordem}</div>
                    </div>
				</div>
			</div>
		</div>
	}

	async Task RenderDnaScoreAsync(DesempenhoDto? desempenho)
	{
		if (desempenho == null)
		{
			<div class="dna-score">
				<div class="score-info">
					<div style="font-weight: 600; margin-bottom: 6px;">Desempenho não disponível</div>
				</div>
			</div>
			return;
		}

		<div class="dna-score">
			<div class="circular-progress" style="--progress: (@desempenho.ScoreDna)/6; --color-main: #00eabc; --color-second: #c0faee;">
				<div class="circular-progress-inner">
					<div class="circular-progress-value">@desempenho.ScoreDna</div>
					<div class="circular-progress-label">DNA</div>
				</div>
			</div>
			<div class="score-info">
				<div style="font-weight: 600; margin-bottom: 6px;">O que é o índice DNA?</div>
				<div style="font-size: 14px">O Score DNA é um sistema que permitirá acompanhar seu rendimento em diferentes momentos.</div>
			</div>
		</div>
	}

	async Task RenderMetricCardAsync(string title, double score, string colorMain, string colorSecond, string message, string description = null, string imc = null)
	{
		<div class="metric-card">
			<div class="card-header @title.ToLower()">
				<div class="card-title">@title</div>
				<div class="card-score">
					<div class="circular-progress" style="--progress: @score; --color-main: @colorMain; --color-second: @colorSecond;">
						<div class="circular-progress-inner">
							<div class="circular-progress-value">@score</div>
						</div>
					</div>
				</div>
			</div>
			<h3>@message</h3>
			@if (imc != null)
			{
				<div class="progress-bar-page1"
					 style="display: flex;
						justify-content: space-between;
						align-items: center;
						padding: 50x 0;
						margin-bottom: 5px;">
					<span>IMC</span>
					<span style="color: #00eabc; font-weight: bold;">@imc</span>
				</div>
				<div class="progress-bar progress-bar-page1">
					<div class="progress" style="width: @GetProgressBarWidth("imc", imc);"></div>
				</div>
			}
			@if (!string.IsNullOrEmpty(description))
			{
				<p style="flex-grow: 1">@description</p>
			}
		</div>
	}

	async Task RenderSectionHeaderAsync(string title, double score, string colorMain, string colorSecond)
	{
		<div class="section-header">
			<div class="card-header @title.ToLower()">
				<div class="card-title">@title</div>
				<div class="card-score">
					<div class="circular-progress" style="--progress: @score; --color-main: @colorMain; --color-second: @colorSecond;">
						<div class="circular-progress-inner">
							<div class="circular-progress-value">@score</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	}

	async Task RenderSportCardAsync(string title, string unit, string value, string message, string description = null, bool showProgressBar = false)
	{
		<div class="sport-card">
			<h3>@title</h3>
			@if (!string.IsNullOrEmpty(message))
			{
				<p>@message</p>
			}
			<div class="metric-value" style="@(showProgressBar ? "border-bottom: none" : "")">
				<span>@unit</span>
				<span class="@(title.Contains("Impulsão") ? "sport" : "default")">@value</span>
			</div>
			@if (showProgressBar && value != "N/A")
			{
				<div class="progress-bar @(title.Contains("Impulsão") ? "progress-bar-sport" : "")">
					<div class="progress @(title.Contains("Impulsão") ? "progress-sport" : "")"
						 style="width: @GetProgressBarWidth(title, value);">
					</div>
				</div>
			}
			@if (!string.IsNullOrEmpty(description))
			{
				<p class="description">@description</p>
			}
			else
			{
				<p class="description">O aluno não tem essa informação preenchida no laudo de Esporte.</p>
			}
		</div>
	}
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@DateTime.Now.ToString("ddMMyyyy")-laudo</title>
	<link href="https://fonts.googleapis.com/css?family=Ubuntu&display=swap" rel="stylesheet" />
	<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
	<link rel="stylesheet" href="~/assets/styles_Laudo/indexLote.css" media="all" />
	<link rel="stylesheet" href="~/assets/styles_Laudo/pages.css" media="all" />
	<style>
		/* Estilo para Laudo Educacional */
		.educacional {
			color: #00a9a9!important;
		}
		.education-section {
			margin-bottom: 20px;
		}
	</style>
</head>
<body>
	<div class="navigation-bar">
		<div class="page-navigation">
			<button class="nav-button" id="prevButton" onclick="previousPage()" title="Página Anterior">
				<span class="material-icons">arrow_upward</span>
			</button>
			<div class="page-counter">
				<span id="currentPage">0</span>/<span id="totalPages">0</span>
			</div>
			<button class="nav-button" id="nextButton" onclick="nextPage()" title="Próxima Página">
				<span class="material-icons">arrow_downward</span>
			</button>
		</div>
		<div class="action-buttons">
			<button class="action-button" onclick="printDocument()" title="Imprimir">
				<span class="material-icons">print</span>
			</button>
			<button class="action-button" onclick="downloadDocument()" title="Baixar">
				<span class="material-icons">download</span>
			</button>
		</div>
	</div>

	@foreach (var laudoResumido in Model.ListLaudosResumidos)
	{
		var desempenho = laudoResumido.Desempenho;
		<div class="page-container page1">
			<div class="newContainer">
				@{
					await RenderHeaderAsync(laudoResumido.NomeModalidade, laudoResumido.ByteImageModalidade);
				}
				<section class="info-section">
					@{
						await RenderStudentInfoAsync(laudoResumido.ByteImageFotoAluno, laudoResumido.NomeAluno, laudoResumido.NomeLocalidade, laudoResumido.Email,
						laudoResumido.Idade, laudoResumido.Etnia, laudoResumido.NomeDeficiencia, laudoResumido.DtNascimento);
						await RenderDnaScoreAsync(laudoResumido.Desempenho);
					}
				</section>

				<div class="cards-grid">
					@if (laudoResumido.SaudeId != null)
					{
						// Verificação de Desempenho nulo antes de acessar suas propriedades
						if (laudoResumido.Desempenho != null)
						{
							var scoreSaude = laudoResumido.Desempenho.ScoreSaude;
							var textoImc = laudoResumido.Desempenho.TextoImc;
							var imcSaude = laudoResumido.ImcSaude != null ? laudoResumido.ImcSaude : null;

							await RenderMetricCardAsync("Saúde", scoreSaude, "#efad57", "#ffeed9",
							"Índice de massa corporal", textoImc, imcSaude);
						}
						else
						{
							// Renderização alternativa quando Desempenho é nulo
							<div class="metric-card">
								<div class="card-header saúde">
									<div class="card-title">Saúde</div>
									<div class="card-score">
										<div>Dados não disponíveis</div>
									</div>
								</div>
							</div>
						}
					}

					@if (laudoResumido.SaudeBucalId != null)
					{
						if (laudoResumido.Desempenho != null && laudoResumido.EncaminhamentoSaudeBucal != null)
						{
							await RenderMetricCardAsync("Saúde Bucal", laudoResumido.Desempenho.ScoreSaudeBucal, "#e96c52", "#fce3de",
							laudoResumido.Desempenho.AvisoSaudeBucal, laudoResumido.EncaminhamentoSaudeBucal.Descricao);
						}
						else
						{
							<div class="metric-card">
								<div class="card-header saúde bucal">
									<div class="card-title">Saúde Bucal</div>
									<div class="card-score">
										<div>Dados não disponíveis</div>
									</div>
								</div>
							</div>
						}
					}

					@if (laudoResumido.ConsumoAlimentarId != null)
					{
						if (laudoResumido.Desempenho != null)
						{
							var descricao = laudoResumido.EncaminhamentoConsumoAlimentar != null ?
							laudoResumido.EncaminhamentoConsumoAlimentar.Descricao : "";

							await RenderMetricCardAsync("Consumo Alimentar", laudoResumido.Desempenho.ScoreConsumoAlimentar,
							"#73dc69", "#deffdc", laudoResumido.Desempenho.AvisoConsumoAlimentar, descricao);
						}
						else
						{
							<div class="metric-card">
								<div class="card-header consumo alimentar">
									<div class="card-title">Consumo Alimentar</div>
									<div class="card-score">
										<div>Dados não disponíveis</div>
									</div>
								</div>
							</div>
						}
					}

					@if (laudoResumido.VocacionalId != null)
					{
						if (laudoResumido.Desempenho != null)
						{
							await RenderMetricCardAsync("Vocação", 100, "#5b5c9c", "#d5d6e7",
							laudoResumido.EncaminhamentoVocacional.Nome, laudoResumido.EncaminhamentoVocacional.Descricao);
						}
						else
						{
							<div class="metric-card">
								<div class="card-header vocação">
									<div class="card-title">Vocação</div>
									<div class="card-score">
										<div>Dados não disponíveis</div>
									</div>
								</div>
							</div>
						}
					}
				</div>
			</div>
			<div class="page-date">
				@DateTime.Now.ToString("D", CultureInfo.CreateSpecificCulture("pt-BR")).ToUpper()
			</div>
		</div>

        <div class="page-container page1">
            <div class="newContainer">
                @if (laudoResumido.QualidadeDeVidaId != null)
                {

                    if (desempenho != null)
                    {
                        <section class="quality-section">
                            @{
                                await RenderSectionHeaderAsync("Qualidade de Vida", desempenho.ScoreVida, "#23bfff", "#c8eeff");
                            }

                            <div class="quality-grid">
                                @{
                                    var textosVida = new List<string>
                                    {
                                        desempenho.TextoBemEstar,
                                        desempenho.TextoAutoestima,
                                        desempenho.TextoFamilia,
                                        desempenho.TextoContexto
                                    };

                                    for (var i = 0; i < laudoResumido.EncaminhamentoQualidadeDeVida.Count; i++)
                                    {
                                        <div class="quality-card">
                                            <h3>@laudoResumido.EncaminhamentoQualidadeDeVida[i].Nome</h3>
                                            <p>@(i < textosVida.Count ? textosVida[i] : "Informação não disponível")</p>
                                        </div>
                                    }
                                }
                            </div>
                        </section>
                    }
                    else
                    {
                        <section class="quality-section">
                            <div class="section-header">
                                <div class="card-header qualidade de vida">
                                    <div class="card-title">Qualidade de Vida</div>
                                    <div class="card-score">
                                        <div>Dados não disponíveis</div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }
                }

                @* Seção do Laudo Educacional - sempre exibida com dados estáticos *@
                @* aqui precisa incluir a verificação se existe laudo educacional *@
                @if ((laudoResumido.TalentoEsportivoId == null && laudoResumido.TalentoEsportivo == null && desempenho == null) || (laudoResumido.QualidadeDeVidaId == null)) {
                    <section class="education-section">
                        @{
                            await RenderSectionHeaderAsync("Educacional", 85, "#00a9a9", "#b3e0e0");
                        }

                        <div class="quality-grid">
                            <div class="quality-card">
                                <h3>Habilidades Cognitivas</h3>
                                <p>O aluno demonstra boa capacidade de raciocínio lógico e resolução de problemas. Apresenta facilidade para compreender conceitos abstratos e estabelecer conexões entre diferentes áreas do conhecimento.</p>
                            </div>
                            <div class="quality-card">
                                <h3>Desempenho Acadêmico</h3>
                                <p>Apresenta rendimento satisfatório nas disciplinas curriculares, com destaque para áreas que envolvem análise e síntese. Demonstra interesse em atividades que estimulam o pensamento crítico.</p>
                            </div>
                            <div class="quality-card">
                                <h3>Habilidades Socioemocionais</h3>
                                <p>Possui boa capacidade de relacionamento interpessoal e trabalho em equipe. Demonstra empatia e consegue expressar suas ideias de forma clara e respeitosa.</p>
                            </div>
                            <div class="quality-card">
                                <h3>Potencial de Aprendizagem</h3>
                                <p>O aluno apresenta bom potencial para desenvolvimento de novas competências. Mostra-se receptivo a feedback e demonstra autonomia na busca por conhecimento.</p>
                            </div>
                        </div>
                    </section>
                }

                @if (laudoResumido.TalentoEsportivoId != null && laudoResumido.TalentoEsportivo != null && desempenho != null)
                {
                    <section class="sport-section">
                        @{
                            await RenderSectionHeaderAsync("Esporte", desempenho.ScoreTalentoEsportivo, "#df436c", "#f7d1db");
                        }

                        <div class="sport-grid">
                            @{
                                // Verificar se ImcSaude não é nulo
                                var imcValue = laudoResumido.ImcSaude != null ? laudoResumido.ImcSaude.ToString() : "N/A";
                                await RenderSportCardAsync("Índice de Massa Corporal", "imc",
                                    imcValue, desempenho.AvisoImc,
                                    desempenho.TextoImc, true);

                                // Verificar se Velocidade não é nulo
                                var velocidadeValue = laudoResumido.TalentoEsportivo.Velocidade != null ?
                                    laudoResumido.TalentoEsportivo.Velocidade.ToString() : "N/A";
                                await RenderSportCardAsync("Velocidade 20m", "seg",
                                    velocidadeValue, "",
                                    desempenho.TextoVelocidade);

                                // Verificar se ImpulsaoHorizontal não é nulo
                                var impulsaoValue = laudoResumido.TalentoEsportivo.ImpulsaoHorizontal != null ?
                                    laudoResumido.TalentoEsportivo.ImpulsaoHorizontal.ToString() : "N/A";
                                await RenderSportCardAsync("Impulsão Horizontal", "cm",
                                    impulsaoValue, desempenho.AvisoImpulsao,
                                    desempenho.TextoImpulsao, true);

                                // Verificar se Flexibilidade não é nulo
                                var flexibilidadeValue = laudoResumido.TalentoEsportivo.Flexibilidade != null ?
                                    laudoResumido.TalentoEsportivo.Flexibilidade.ToString() : "N/A";
                                await RenderSportCardAsync("Flexibilidade", "cm",
                                    flexibilidadeValue, desempenho.AvisoFlexibilidadeMuscular,
                                    desempenho.TextoFlexibilidadeMuscular, true);

                                // Verificar se Vo2Max não é nulo
                                var vo2MaxValue = laudoResumido.TalentoEsportivo.Vo2Max != null ?
                                    laudoResumido.TalentoEsportivo.Vo2Max.ToString() : "N/A";
                                await RenderSportCardAsync("Aptidão Aeróbica", "seg",
                                    vo2MaxValue, "",
                                    desempenho.TextoAptidaoCardio);

                                // Verificar se PreensaoManual não é nulo
                                var preensaoValue = laudoResumido.TalentoEsportivo.PreensaoManual != null ?
                                    laudoResumido.TalentoEsportivo.PreensaoManual.ToString() : "N/A";
                                await RenderSportCardAsync("Preensão Manual", "kg",
                                    preensaoValue, desempenho.AvisoForcaMembrosSup,
                                    desempenho.TextoForcaMembrosSup, true);
                            }
                        </div>
                    </section>
                }
            </div>
        </div>

		@* aqui precisa incluir a verificação se existe laudo educacional *@
        @if ((laudoResumido.TalentoEsportivoId != null && laudoResumido.TalentoEsportivo != null && desempenho != null) && (laudoResumido.QualidadeDeVidaId != null))
		{
			        <div class="page-container page1">
            <div class="newContainer">
                @* Seção do Laudo Educacional - sempre exibida com dados estáticos por enquanto *@
                    <section class="education-section">
                        @{
                            await RenderSectionHeaderAsync("Educacional", 85, "#00a9a9", "#b3e0e0");
                        }

                        <div class="quality-grid">
                            <div class="quality-card">
                                <h3>Habilidades Cognitivas</h3>
                                <p>O aluno demonstra boa capacidade de raciocínio lógico e resolução de problemas. Apresenta facilidade para compreender conceitos abstratos e estabelecer conexões entre diferentes áreas do conhecimento.</p>
                            </div>
                            <div class="quality-card">
                                <h3>Desempenho Acadêmico</h3>
                                <p>Apresenta rendimento satisfatório nas disciplinas curriculares, com destaque para áreas que envolvem análise e síntese. Demonstra interesse em atividades que estimulam o pensamento crítico.</p>
                            </div>
                            <div class="quality-card">
                                <h3>Habilidades Socioemocionais</h3>
                                <p>Possui boa capacidade de relacionamento interpessoal e trabalho em equipe. Demonstra empatia e consegue expressar suas ideias de forma clara e respeitosa.</p>
                            </div>
                            <div class="quality-card">
                                <h3>Potencial de Aprendizagem</h3>
                                <p>O aluno apresenta bom potencial para desenvolvimento de novas competências. Mostra-se receptivo a feedback e demonstra autonomia na busca por conhecimento.</p>
                            </div>
                        </div>
                    </section>
            </div>
        </div>
		}
	}

	<script src="~/assets/scripts_Laudo/index.js"></script>
</body>
</html>

@model LaudoModel
@{
    ViewData["Title"] = "Visualização de Gabaritos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="vLaudo">
    <div class="row">
        <div class="col-lg-12">
            <section class="panel">
                <header class="panel-heading">
                    <div class="panel-actions">
                        <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
                    </div>
                    <h2 class="panel-title">Visualização de Gabaritos</h2>
                </header>
                <div class="panel-body">
                    <div class="form-group row">
                        @if (Model.Educacionais != null && Model.Educacionais.Any())
                        {
                            <div class="row">
                                @foreach (var edu in Model.Educacionais)
                                {
                                    if (!string.IsNullOrWhiteSpace(edu.Imagem))
                                    {
                                        var img = "\\Gabaritos" + edu.Imagem.Split("\\Gabaritos")[1];
                                        <div class="col-md-12">
                                            <img src="@img" alt="Imagem do Educacional" class="img-fluid"/>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col-md-4">Nenhuma imagem encontrada para este aluno.</div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/ios7-switch/ios7-switch.js"></script>
    <script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
    <script src="~/js/Laudo.js"></script>
}

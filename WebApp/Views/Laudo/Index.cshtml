    <script src="~/js/Laudo.js"></script>

    <script>


        $('#btnImprimirLaudo').click(function (e) {
                e.preventDefault();

                var filtros = {
                    ddlFomento: $('#ddlFomento').val(),
                    ddlEstado: $('#ddlEstado').val(),
                    ddlMunicipio: $('#ddlMunicipio').val(),
                    ddlLocalidade: $('#ddlLocalidade').val(),
                    ddlAluno: $('#ddlAluno').val(),
                    ddlTipoLaudo: $('#ddlTipoLaudo').val(),
                    ddlDeficiencia: $('#ddlDeficiencia').val(),
                    possuiFoto: $('#possuiFoto').is(':checked').toString(),
                    finalizado: $('#finalizado').is(':checked').toString()
                };

                var queryString = Object.keys(filtros)
                    .filter(key => filtros[key] !== null && filtros[key] !== undefined)
                    .map(key => `${key}=${encodeURIComponent(filtros[key])}`)
                    .join('&');

                var url = $(this).attr('href');
                if (queryString) {
                    url += '?' + queryString;
                }

                // Exibir algum indicador de carregamento (opcional)
                $('#loading-indicator').show();

                // Fazer o download do PDF
                window.open(url, '_blank');
            });

        $('#btnExportarLaudo').click(function (e) {
            e.preventDefault();

            var filtros = {
                ddlFomento: $('#ddlFomento').val(),
                ddlEstado: $('#ddlEstado').val(),
                ddlMunicipio: $('#ddlMunicipio').val(),
                ddlLocalidade: $('#ddlLocalidade').val(),
                ddlAluno: $('#ddlAluno').val(),
                ddlTipoLaudo: $('#ddlTipoLaudo').val(),
                possuiFoto: $('#possuiFoto').is(':checked').toString(),
                finalizado: $('#finalizado').is(':checked').toString()
            };

            var queryString = Object.keys(filtros)
                .filter(key => filtros[key] !== null && filtros[key] !== undefined)
                .map(key => `${key}=${encodeURIComponent(filtros[key])}`)
                .join('&');

            var url = $(this).attr('href');
            if (queryString) {
                url += '?' + queryString;
            }

            window.location.href = url;
        });

        // function submitQuestionario() {
        // 	// Coleta os valores dos campos do formulário
        // 	var estado = $('#ddlEstadoGabarito').val();
        // 	var municipio = $('#ddlMunicipioGabarito').val();
        // 	var localidade = $('#ddlLocalidadeGabarito').val();
        // 	var aluno = $('#ddlAlunoGabarito').val();
        // 	var gabarito = $('#ddlGabarito').val();

        // 	// Validação simples
        // 	if (!estado || !municipio || !localidade) {
        // 		alert('Preencha todos os campos obrigatórios para imprimir o gabarito.');
        // 		return;
        // 	}

        // 	// Monta a URL de destino
        // 	var url = '/Laudo/PrintGabarito'
        // 		+ '?ddlEstadoGabarito=' + encodeURIComponent(estado)
        // 		+ '&ddlMunicipioGabarito=' + encodeURIComponent(municipio)
        // 		+ '&ddlLocalidadeGabarito=' + encodeURIComponent(localidade)
        // 		+ '&ddlAlunoGabarito=' + encodeURIComponent(aluno)
        // 		+ '&ddlGabarito=' + encodeURI(gabarito);

        // 	// Abre em nova aba para impressão
        // 	window.open(url, '_blank');
        // }


        (function ($) {

            'use strict';
            var crud = @ViewBag.CrudMessage;

            if (crud === 1) {
                new PNotify({
                    title: 'Laudo',
                    text: 'Cadastro realizado com sucesso!',
                    type: 'success'
                });
                crud = 0;
            } else if (crud === 2) {
                new PNotify({
                    title: 'Laudo',
                    text: 'Dados alterados com sucesso.',
                    type: 'warning',
                    icon: 'fa fa-pencil'
                });
                crud = 0;
            } else if (crud === 3) {
                new PNotify({
                    title: 'Laudo',
                    text: 'Registro excluído com sucesso.',
                    type: 'error',
                    icon: 'fa fa-trash-o'
                });
                crud = 0;
            }


            var notify = @ViewBag.NotifyMessage;
            var messagem = '@ViewBag.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'Laudo',
                    text: messagem,
                    type: 'success'
                });
                crud = 0;
            } else if (notify === 1) {
                new PNotify({
                    title: 'Laudo',
                    text: messagem,
                    type: 'warning'
                });
                crud = 0;
            } else if (notify === 2) {
                new PNotify({
                    title: 'Laudo',
                    text: messagem,
                    type: 'error'
                });
                crud = 0;
            }

            if ($.isFunction($.fn['tooltip'])) {
                $('[data-toggle=tooltip],[rel=tooltip]').tooltip({ container: 'body' });
            }

        }).apply(this, [jQuery]);

    </script>

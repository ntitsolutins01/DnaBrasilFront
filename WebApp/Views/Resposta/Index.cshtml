@model WebApp.Models.RespostaModel
@{
    ViewData["Title"] = "Listagem de Respostas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="formResposta">
    <div class="row">
        <div class="col-lg-12">
            <section class="panel">
                <header class="panel-heading">
                    <div class="panel-actions">
                        <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
                    </div>
                    <h2 class="panel-title">Listagem de Respostas</h2>
                </header>
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-sm-12 pull-right">
                            <a href="@Url.Action("Create", "Resposta")" id="addToTable" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> &nbsp;&nbsp;Nova Resposta </a>
                        </div>
                    </div>
                    <table class="table table-bordered table-striped mb-0" id="datatable-default">
                        <thead>
                            <tr>
                                <th class="text-center">Id</th>
                                <th class="text-center">Tipo Laudo</th>
                                <th class="text-center">Questionário Id</th>
                                <th class="text-center">Questionário</th>
                                <th class="text-center">Resposta</th>
                                <th class="text-center">Valor/Peso Resposta</th>
                                <th class="text-center">Ações</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Respostas)
                            {
                                <tr>
                                    <td class="text-center" style="width:20px;">@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td class="text-center" style="width:150px;">@Html.DisplayFor(modelItem => item.NomeTipoLaudo)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.QuestionarioId)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Pergunta)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.RespostaQuestionario)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.ValorPesoResposta)</td>
                                    <td class="actions text-center">
                                        <a data-toggle="tooltip" data-placement="top" title="Editar"
                                           href='javascript:(crud.EditModal(@item.Id))'
                                           class="on-default edit-row" style='color: #FF9800'>
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" title="Excluir" href='javascript:(crud.DeleteModal(@item.Id))'
                                           class="on-default remove-row" style="cursor: pointer;color: #F44336"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdDeleteResposta" tabindex="-1" role="dialog" aria-labelledby="mdDeleteRespostaLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdDeleteRespostaLabel">
                        <i class="fa fa-trash"></i> &nbsp;&nbsp;<strong>Exclusão de Resposta</strong>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="modal-icon">
                        <i class="fa fa-question-circle"></i>
                    </div>
                    <div class="modal-text">
                        <input type="hidden" id="deleteRespostaId" />
                        <p class="mb-0">Tem certeza que deseja <b>excluir</b> esse registro?</p>
                    </div>
                    <div class="modal-wrapper">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-thumbs-o-down"></i> &nbsp;&nbsp;Não</button>
                    <a id="deleteRespostaHref" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-thumbs-o-up"></i> &nbsp;&nbsp;Sim</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdEditResposta" tabindex="-1" role="dialog" aria-labelledby="mdEditRespostaLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdEditRespostaLabel">
                        <i class="fa fa-pencil"></i> &nbsp;&nbsp;<strong>Alterar Resposta</strong>
                    </h5>
                </div>
                @using (@Html.BeginForm("Edit", "Resposta", FormMethod.Post, new { id = "formEditResposta", @class = "form-horizontal" }))
                {
                    <input type="hidden" name="editRespostaId" :value="editDto.Id" />
                    
                    <div class="form-group row">
                        <label class="col-sm-3 control-label text-sm-right pt-2">Tipo Laudo: </label>
                        <div class="col-sm-4">
                            <input type="text" id="tipoLaudo" name="tipoLaudo" class="form-control"
                                   maxlength="80" :value="editDto.TipoLaudo"
                                   title="Por favor informe o Tipo Laudo." readonly />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 control-label text-sm-right pt-2">Questionário: </label>
                        <div class="col-sm-8">
                            <input type="text" id="questionario" name="questionario" class="form-control"
                                   maxlength="500" :value="editDto.Questionario"
                                   title="Por favor informe o questionário." readonly />
                        </div>
                    </div>
	                <div class="form-group row">
		                <label class="col-sm-3 control-label text-sm-right pt-2">Resposta: <span class="required">*</span></label>
		                <div class="col-sm-8">
			                <input type="text" id="resposta" name="resposta" class="form-control"
                                   maxlength="100" :value="editDto.Resposta"
			                       title="Por favor informe a Resposta." required />
		                </div>
	                </div>
                    <div class="form-group row">
                        <label class="col-sm-3 control-label text-sm-right pt-2">Valor/Peso Resposta: <span class="required">*</span></label>
                        <div class="col-sm-2">
                            <div>
                                <input type="text" id="valorPeso" name="valorPeso" class="form-control" maxlength="5"
                                       title="Por favor informe o Valor Peso da Resposta." :value="editDto.ValorPesoResposta" required/>
                            </div>
                            
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
                        <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/datatables/media/css/dataTables.bootstrap4.css" />
}
@section Scripts {
    <script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
    <script src="~/assets/vendor/ios7-switch/ios7-switch.js"></script>
    <script src="~/assets/vendor/jquery-mask/jquery.mask.js"></script>
    <script src="~/assets/vendor/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables/media/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/formatTable.js"></script>
    <script src="~/js/Resposta.js"></script>

    <script>

        (function ($) {

            'use strict';
            var crud = @ViewBag.CrudMessage;

            if (crud === 1) {
                new PNotify({
                    title: 'Resposta',
                    text: 'Cadastro realizado com sucesso!',
                    type: 'success'
                });
                crud = 0;
            } else if (crud === 2) {
                new PNotify({
                    title: 'Resposta',
                    text: 'Dados alterados com sucesso.',
                    type: 'warning',
                    icon: 'fa fa-pencil'
                });
                crud = 0;
            } else if (crud === 3) {
                new PNotify({
                    title: 'Resposta',
                    text: 'Registro excluído com sucesso.',
                    type: 'error',
                    icon: 'fa fa-trash-o'
                });
                crud = 0;
            }


            var notify = @ViewBag.NotifyMessage;
            var messagem = '@ViewBag.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'Resposta',
                    text: messagem,
                    type: 'success'
                });
                crud = 0;
            } else if (notify === 1) {
                new PNotify({
                    title: 'Resposta',
                    text: messagem,
                    type: 'warning'
                });
                crud = 0;
            } else if (notify === 2) {
                new PNotify({
                    title: 'Resposta',
                    text: messagem,
                    type: 'error'
                });
                crud = 0;
            }

            if ($.isFunction($.fn['tooltip'])) {
                $('[data-toggle=tooltip],[rel=tooltip]').tooltip({ container: 'body' });
            }

        }).apply(this, [jQuery]);
    </script>
}




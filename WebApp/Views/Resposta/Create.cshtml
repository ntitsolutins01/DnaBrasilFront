@model RespostaModel
@{
	ViewData["Title"] = "Inclusão de Resposta";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
	<div class="col-md-12">
		@using (@Html.BeginForm("Create", "Resposta", FormMethod.Post, new { id = "formResposta", @class = "form-horizontal" }))
		{
			<section class="panel">
				<header class="panel-heading">
					<div class="panel-actions">
						<a href="#" class="panel-action panel-action-toggle" data-panel-toggle></a>
					</div>

					<h2 class="panel-title">Cadastro de Resposta</h2>
				</header>
				<div class="panel-body">
					<div class="form-group row">
						<label class="col-sm-2 control-label text-sm-right pt-2">Tipo <span class="required">*</span></label>
						<div class="col-md-4">
							<select class="form-control populate select2" name="ddlTipoLaudo" id="ddlTipoLaudo"
									title="Por favor selecione o tipo de laudo." required
									asp-for="TipoLaudoId" asp-items="Model.ListTiposLaudos">
								<option value="">Selecionar Tipo Laudo</option>
							</select>
						</div>
					</div>
					<div class="form-group row">
						<label class="col-sm-2 control-label text-sm-right pt-2">Questionário <span class="required">*</span></label>
						<div class="col-md-10">
							<select class="form-control populate select2" name="ddlQuestionario" id="ddlQuestionario"
									title="Por favor selecione o questionário." required
									asp-for="QuestionarioId" asp-items="Model.ListQuestionarios">
								<option value="">Selecionar Questionário</option>
							</select>
						</div>
					</div>
					<div class="form-group row">
						<label class="col-sm-2 control-label text-sm-right pt-2">Resposta <span class="required">*</span></label>
						<div class="col-sm-10">
							<input type="text" name="resposta" class="form-control"
								   maxlength="300"
								   title="Por favor informe a Resposta." required />
						</div>
					</div> 
					<div class="form-group row" id="dvEducacional" style="display: none;">
						<label class="col-sm-2 control-label text-sm-right pt-2">Descrição </label>
						<div class="col-sm-10">
							<textarea class="form-control" rows="3" maxlength="500"  name="descricao"  id="descricao"></textarea>
						</div>
					</div>
					<div class="form-group row">
						<label class="col-sm-2 control-label text-sm-right pt-2">Valor/Peso Resposta <span class="required">*</span></label>
						<div class="col-sm-2">
                            <input type="text" id="valorPeso" name="valorPeso" class="form-control" maxlength="5"
                                   title="Por favor informe o Valor Peso da Resposta." required />
						</div>
					</div>
					
				</div>
				<footer class="panel-footer">
					<div class="row">
						<div class="col-md-9 col-md-offset-3">
							<a href="@Url.Action("Index", "Resposta")" class="btn btn-dark pull-right" style="margin-left: 5px;margin-right: 5px;"><i class="fa fa-reply"></i> &nbsp;&nbsp;Voltar</a>
							<button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
							<button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
						</div>
					</div>
				</footer>
			</section>
		}
	</div>
</div>
@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/select2/css/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/select2-bootstrap-theme/select2-bootstrap.min.css" />
}
@section Scripts {
	<script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
	<script src="~/assets/vendor/jquery-mask/jquery.mask.js"></script>
    <script src="~/assets/vendor/select2/js/select2.js"></script>
	<script src="~/js/Resposta.js"></script>
	<script>

		(function ($) {

			'use strict';
			var crud = @ViewBag.CrudMessage;

			if (crud === 1) {
				new PNotify({
					title: 'Resposta',
					text: 'Cadastro realizado com sucesso!',
					type: 'success'
				});
			} else if (crud === 2) {
				new PNotify({
					title: 'Resposta',
					text: 'Dados alterados com sucesso.',
					type: 'warning'
				});
			} else if (crud === 3) {
				new PNotify({
					title: 'Resposta',
					text: 'Registro excluído com sucesso.',
					type: 'error'
				});
			}

			var notify = @ViewBag.NotifyMessage;
			var messagem = '@ViewBag.Notify';

			if (notify === 0) {
				new PNotify({
					title: 'Resposta',
					text: messagem,
					type: 'success'
				});
			} else if (notify === 1) {
				new PNotify({
					title: 'Resposta',
					text: messagem,
					type: 'warning'
				});
			} else if (notify === 2) {
				new PNotify({
					title: 'Resposta',
					text: messagem,
					type: 'error'
				});
			}

		}).apply(this, [jQuery]);

	</script>
}
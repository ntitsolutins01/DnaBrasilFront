@model AlunoCursoCertificadoModel
@{
    ViewData["Title"] = "Cadastro de Aluno em Curso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="vAlunoCurso">
    <div class="row">
        <div class="col-md-12">
            @using (@Html.BeginForm("CreateAlunoCurso", "AlunoCursoCertificado", FormMethod.Post, new { id = "formAlunoCurso", @class = "form-horizontal" }))
            {
                <section class="panel">
                    <header class="panel-heading">
                        <div class="panel-actions">
                            <a href="#" class="panel-action panel-action-toggle" data-panel-toggle></a>
                        </div>
                        <h2 class="panel-title">Cadastro de Aluno em Curso</h2>
                    </header>
                    <div class="panel-body">
                        <div class="panel-body">
                            <div class="form-group row">
                                <label class="col-sm-3 control-label">Estado </label>
                                <div class="col-md-2 form-group">
                                    <select class="form-control populate select2" name="ddlEstado" id="ddlEstado" style="width:100%"
                                            asp-for="EstadoId" asp-items="Model.ListEstados">
                                        <option value="">Selecionar Estado</option>
                                    </select>
                                </div>
                                <label class="col-sm-1 control-label">Município </label>
                                <div class="col-md-2 form-group">
                                    <select class="form-control populate select2" name="ddlMunicipio" id="ddlMunicipio" style="width:100%"
                                            asp-for="MunicipioId" asp-items="Model.ListMunicipios">
                                        <option value="">Selecionar Municipio</option>
                                    </select>
                                </div>
                                <label class="col-sm-1 control-label">Localidade </label>
                                <div class="col-md-3 form-group">
                                    <select class="form-control populate select2" name="ddlLocalidade" id="ddlLocalidade" style="width:100%"
                                            asp-for="LocalidadeId" asp-items="Model.ListLocalidades">
                                        <option value="">Selecionar Localidade</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-3 control-label">Aluno <span class="required">*</span></label>
                                <div class="col-sm-2">
                                    <select class="form-control populate select2" name="ddlAluno" id="ddlAluno" style="width:100%"
                                            required title="Por favor selecione o aluno."
                                            asp-for="AlunoId" asp-items="Model.ListAlunos">
                                        <option value="">Selecionar Aluno</option>
                                    </select>
                                </div>
                                <label class="col-sm-1 control-label">Curso <span class="required">*</span></label>
                                <div class="col-sm-4">
                                    <select class="form-control populate select2" name="ddlCurso" id="ddlCurso" style="width:100%"
                                            required title="Por favor selecione o curso"
                                            asp-for="CursoId" asp-items="Model.ListCursos">
                                        <option value="">Selecionar Curso</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-md-9 col-md-offset-3">
                                <a href="@Url.Action("Index", "AlunoCursoCertificado")" class="btn btn-dark pull-right" style="margin-left: 5px;margin-right: 5px;"><i class="fa fa-reply"></i> &nbsp;&nbsp;Voltar</a>
                                <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
                                <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
                            </div>
                        </div>
                    </footer>
                </section>

            }
        </div>
    </div>
</div>
@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-fileupload/bootstrap-fileupload.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/select2/css/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/select2-bootstrap-theme/select2-bootstrap.min.css" />
}
@section Scripts {
    <script src="~/assets/vendor/bootstrap-fileupload/bootstrap-fileupload.min.js"></script>
    <script src="~/assets/vendor/select2/js/select2.js"></script>
    <script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
    <script src="~/assets/vendor/jquery-mask/jquery.mask.js"></script>
    <script src="~/js/AlunoCurso.js"></script>
    <script>

        (function ($) {

            'use strict';
            var crud = @ViewBag.CrudMessage;

            if (crud === 1) {
                new PNotify({
                    title: 'Meus Cursos',
                    text: 'Cadastro realizado com sucesso!',
                    type: 'success'
                });
            } else if (crud === 2) {
                new PNotify({
                    title: 'Meus Cursos',
                    text: 'Dados alterados com sucesso.',
                    type: 'warning'
                });
            } else if (crud === 3) {
                new PNotify({
                    title: 'Meus Cursos',
                    text: 'Registro excluído com sucesso.',
                    type: 'error'
                });
            }

            var notify = @ViewBag.NotifyMessage;
            var messagem = '@ViewBag.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'Meus Cursos',
                    text: messagem,
                    type: 'success'
                });
            } else if (notify === 1) {
                new PNotify({
                    title: 'Meus Cursos',
                    text: messagem,
                    type: 'warning'
                });
            } else if (notify === 2) {
                new PNotify({
                    title: 'Meus Cursos',
                    text: messagem,
                    type: 'error'
                });
            }

        }).apply(this, [jQuery]);

    </script>
}
@model QuestaoEadModel.QuestaoEadViewModel

@if (Model.Questoes == null || !Model.Questoes.Any())
{
    <div class="alert alert-info">Nenhuma questão encontrada para esta aula.</div>
}
else
{
    <div class="questoes-list">
        @foreach (var q in Model.Questoes)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <strong>Questão @q.NumeroQuestao</strong>
                </div>
                <div class="card-body">
                    @if (q.Imagens.Any())
                    {
                        <div>
                            <h6 class="mb-1">Imagens</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var img in q.Imagens.OrderBy(x => x.Ordem))
                                {
                                    var valor = img.Valor ?? string.Empty;
                                    string caminhoImagem = "\\QuestoesEad" + valor.Split("\\QuestoesEad")[1];
                                    <img src="@caminhoImagem"
                                         alt="Imagem da questão @q.NumeroQuestao (@img.Ordem)"
                                         style="max-width:100%; height:auto; object-fit:contain;" />
                                }
                            </div>
                        </div>
                    }

                    @if (q.Textos.Any())
                    {
                        <div class="mb-2">
                            <h6 class="mb-1">Textos</h6>
                            <ol class="mb-0">
                                @foreach (var t in q.Textos.OrderBy(x => x.Ordem))
                                {
                                    <li>@t.Valor</li>
                                }
                            </ol>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(q.Referencia))
                    {
                        <small class="text-muted">Referência: @q.Referencia</small>
                        <hr />
                    }

                    <p class="mb-2">@q.Enunciado</p>

                    @* <------ Respostas ------> *@

                    @{
                        var respostas = q.Respostas;
                        var tipo = (respostas.FirstOrDefault()?.TipoResposta ?? "").ToUpperInvariant();

                        Func<int, string> letra = idx => (idx >= 0 && idx < 26)
                        ? ((char)('A' + idx)).ToString()
                        : "/";
                    }

                    @switch (tipo)
                    {
                        case "A":  // Alternativa única
                            {
                                <div class="mb-2">
                                    @for (int i = 0; i < respostas.Count; i++)
                                    {
                                        var r = respostas[i];
                                        var l = letra(i);
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="radio" name="q_@q.Id" />
                                            <span class="badge bg-primary me-2" style="min-width:24px;text-align:center;">@l</span>
                                            @r.Resposta
                                        </div>
                                    }
                                </div>
                                break;
                            }

                        case "M":  // Múltipla escolha
                            {
                                <div class="mb-2">
                                    @for (int i = 0; i < respostas.Count; i++)
                                    {
                                        var r = respostas[i];
                                        var l = letra(i);
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox" name="q_@q.Id" />
                                            <span class="badge bg-primary me-2" style="min-width:24px;text-align:center;">@l</span>
                                            @r.Resposta
                                        </div>
                                    }
                                </div>
                                break;
                            }

                        default:    // Dissertativa
                            {
                                <div class="mb-2">
                                    @{
                                        var texto = respostas.FirstOrDefault()?.Resposta;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(texto))
                                    {
                                        <div class="form-control-plaintext border rounded p-2 bg-light" style="white-space:pre-wrap;">
                                            @texto
                                        </div>
                                    }
                                </div>
                                break;
                            }
                    }

                </div>
            </div>
        }
    </div>
}

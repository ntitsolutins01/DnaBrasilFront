@model MaterialModel
@{
    ViewData["Title"] = "Listagem de Materiais";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="vMaterial">
    <div class="row">
        <div class="col-md-12">
            @using (@Html.BeginForm("Index", "Material", FormMethod.Post, new { id = "formPesquisarMaterial", @class = "form-horizontal" }))
            {
                <section class="panel">
                    <header class="panel-heading">
                        <div class="panel-actions">
                            <a href="#" class="panel-action panel-action-toggle" data-panel-toggle></a>
                        </div>
                        <h2 class="panel-title">Filtro de pesquisa</h2>
                    </header>
                    <div class="panel-body" id="pFiltro">
                        <label class="col-sm-2 control-label text-sm-right pt-2">Id:</label>
                        <div class="col-sm-4 form-group">
                            <input type="text" name="material" id="material" class="form-control" placeholder="Insira Material"
                                   maxlength="60"
                                   title="Por favor informe o material." />
                        </div>
                        <label class="col-sm-2 control-label text-sm-right pt-2">Descrição:</label>
                        <div class="col-sm-4 form-group">
                            <input type="text" name="nomeMaterial" id="nomeMaterial" class="form-control" placeholder="Insira Descrição"
                                   maxlength="60"
                                   title="Por favor informe o material." />
                        </div>
                        <label class="col-sm-2 control-label">Tipo Material:</label>
                        <div class="col-sm-4 form-group">
                            <select class="form-control populate select2" name="ddlTipoMaterial" id="ddlTipoMaterial" style="width:100%"
                                    title="Por favor selecione um tipo de material."
                                    asp-for="TipoMaterialId" asp-items="Model.ListTiposMateriais">
                                <option value="">Selecionar Tipo de Material</option>
                            </select>
                        </div>
                    </div>
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-sm-2 pull-right">
                                <button type="submit" class="btn btn-block btn-info pull-right">
                                    <i class="fa fa-search"></i> &nbsp;&nbsp;Pesquisar
                                </button>
                            </div>
                        </div>
                    </footer>
                </section>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <section class="panel">
                <header class="panel-heading">
                    <div class="panel-actions">
                        <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
                    </div>
                    <h2 class="panel-title">Listagem de Materiais</h2>
                </header>
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-sm-12 pull-right">
                            <a href="@Url.Action("Create", "Material")" id="addToTable" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> Novo Material </a>
                        </div>
                    </div>
                    <table class="table table-bordered table-striped mb-0" id="datatable-default">
                        <thead>
                            <tr>
                                <th class="text-center">Id</th>
                                <th class="text-center">Localidade</th>
                                <th class="text-center">Tipo de Material</th>
                                <th class="text-center">Descrição</th>
                                <th class="text-center">Unidade de Medida</th>
                                <th class="text-center">Quantidade</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Materiais)
                            {
                                <tr>
                                    <td class="text-center" style="width:20px;">@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.NomeLocalidade)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.TituloTipoMaterial)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Descricao)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.UnidadeMedida)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.QtdAdquirida)</td>

                                    <td class="actions text-center">
                                        <a data-toggle="tooltip" data-placement="top" title="Editar"
                                           href='javascript:(crud.EditModal(@item.Id))'
                                           class="on-default edit-row" style='color: #FF9800'>
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" title="Excluir" href='javascript:(crud.DeleteModal(@item.Id))'
                                           class="on-default remove-row" style="Materialr: pointer;color: #F44336"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdDeleteMaterial" tabindex="-1" role="dialog" aria-labelledby="mdDeleteMaterialLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdDeleteMaterialLabel">
                        <i class="fa fa-trash"></i> &nbsp;&nbsp;<strong>Exclusão de Material</strong>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="modal-icon">
                        <i class="fa fa-question-circle"></i>
                    </div>
                    <div class="modal-text">
                        <input type="hidden" id="deleteMaterialId" />
                        <p class="mb-0">Tem certeza que deseja <b>excluir</b> esse registro?</p>
                    </div>
                    <div class="modal-wrapper">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-thumbs-o-down"></i> &nbsp;&nbsp;Não</button>
                    <a id="deleteMaterialHref" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-thumbs-o-up"></i> &nbsp;&nbsp;Sim</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdEditMaterial" tabindex="-1" role="dialog" aria-labelledby="mdEditMaterialLabel" aria-hidden="true">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdEditMaterialLabel">
                        <i class="fa fa-pencil"></i> &nbsp;&nbsp;<strong>Alterar Material</strong>
                    </h5>
                </div>
                @using (@Html.BeginForm("Edit", "Material", FormMethod.Post, new { id = "formEditMaterial", @class = "form-horizontal" }))
                {
                    <div class="modal-body">
                        <input type="hidden" name="editMaterialId" :value="editDto.Id" />
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Descrição </label>
                            <div class="col-sm-9">
                                <input type="text" name="descricao" id="descricao" class="form-control"
                                       maxlength="150" :value="editDto.Descricao"
                                       title="Por favor informe a descrição." required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Unidade de Medida <span class="required">*</span></label>
                            <div class="col-sm-9">
                                <select class="form-control populate select2" name="ddlUnidadeMedida" id="ddlUnidadeMedida" style="width:100%"
                                        required title="Por favor selecione a unidade. " :value="editDto.UnidadeMedida"
                                        asp-for="UnidadeId" asp-items="Model.ListUnidadesMedidas">
                                    <option value="">Selecionar a Unidade</option>
                                </select>
                            </div>
                            @* <label class="col-sm-2 control-label text-sm-right pt-2">Quantidade </label>
                            <div class="col-sm-2">
                                <input type="text" name="qtdAdquirida" id="qtdAdquirida" class="form-control"
                                       maxlength="10" :value="editDto.QtdAdquirida"
                                       title="Por favor informe a quantidade." required />
                            </div> *@
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
                        <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/select2/css/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/select2-bootstrap-theme/select2-bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/datatables/media/css/dataTables.bootstrap4.css" />
}
@section Scripts {
    <script src="~/assets/vendor/select2/js/select2.js"></script>
    <script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
    <script src="~/assets/vendor/jquery-mask/jquery.mask.js"></script>
    <script src="~/assets/vendor/ios7-switch/ios7-switch.js"></script>
    <script src="~/assets/vendor/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables/media/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/formatTable.js"></script>
    <script src="~/js/Material.js"></script>

    <script>

        (function ($) {

            'use strict';
            var crub = @ViewBag.CrudMessage;

            if (crub === 1) {
                new PNotify({
                    title: 'Material',
                    text: 'Cadastro realizado com sucesso!',
                    type: 'success'
                });
                crub = 0;
            } else if (crub === 2) {
                new PNotify({
                    title: 'Material',
                    text: 'Dados alterados com sucesso.',
                    type: 'warning',
                    icon: 'fa fa-pencil'
                });
                crub = 0;
            } else if (crub === 3) {
                new PNotify({
                    title: 'Material',
                    text: 'Registro excluído com sucesso.',
                    type: 'error',
                    icon: 'fa fa-trash-o'
                });
                crub = 0;
            }


            var notify = @ViewBag.NotifyMessage;
            var messagem = '@ViewBag.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'Material',
                    text: messagem,
                    type: 'success'
                });
                crub = 0;
            } else if (notify === 1) {
                new PNotify({
                    title: 'Material',
                    text: messagem,
                    type: 'warning'
                });
                crub = 0;
            } else if (notify === 2) {
                new PNotify({
                    title: 'Material',
                    text: messagem,
                    type: 'error'
                });
                crub = 0;
            }

            if ($.isFunction($.fn['tooltip'])) {
                $('[data-toggle=tooltip],[rel=tooltip]').tooltip({ container: 'body' });
            }

        }).apply(this, [jQuery]);
    </script>
}




@model WebApp.Models.FomentoModel
@{
    ViewData["Title"] = "Listagem de Fomentos / Contratos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="vFomento">
    <div class="row">
        <div class="col-lg-12">
            <section class="panel">
                <header class="panel-heading">
                    <div class="panel-actions">
                        <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
                    </div>
                    <h2 class="panel-title">Listagem de Fomentos</h2>
                </header>
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-sm-12 pull-right">
                            <a href="@Url.Action("Create", "Fomento")" id="addToTable" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> Novo Fomento </a>
                        </div>
                    </div>
                    <table class="table table-bordered table-striped mb-0" id="datatable-default">
                        <thead>
                            <tr>
                                <th class="text-center">Id</th>
                                <th class="text-center">Código do Fomento</th>
                                <th class="text-center">Fomento</th>
                                <th class="text-center">Localidade - Municipio/UF</th>
	                            <th class="text-center">Data Inicío</th>
	                            <th class="text-center">Data fim</th>
	                            <th class="text-center">Status</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Fomentos)
                            {
                                <tr>
                                    <td class="text-center" style="width:20px;">@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Codigo)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Nome)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Localidade) - 
                                        @Html.DisplayFor(modelItem => item.MunicipioEstado)</td>
	                                <td class="text-center">@Html.DisplayFor(modelItem => item.DtIni)</td>
	                                <td class="text-center">@Html.DisplayFor(modelItem => item.DtFim)</td>
	                                @if (item.Status)
	                                {
		                                <td class="text-center"><span class="label label-success">ATIVO</span></td>
	                                }
	                                else
	                                {
		                                <td class="text-center"><span class="label label-danger">INATIVO</span></td>
	                                }
                                    <td class="actions text-center">
	                                    <a data-toggle="tooltip" data-placement="top" title="Vincular Localidades" href='javascript:(crud.VincularLocalidadesModal(@item.Id))'
	                                       class="on-default remove-row" style="cursor: pointer;color: #7B1FA2"><i class="fa fa-link"></i></a>
                                        <a data-toggle="tooltip" data-placement="top" title="Editar" asp-action="Edit" asp-controller="Fomento" asp-route-Id="@item.Id" class="on-default edit-row" style='color: #FF9800'><i class="fa fa-pencil"></i></a>
                                        <a data-toggle="tooltip" data-placement="top" title="Excluir" href='javascript:(crud.DeleteModal(@item.Id))'
                                           class="on-default remove-row" style="cursor: pointer;color: #F44336"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdDeleteFomento" tabindex="-1" role="dialog" aria-labelledby="mdDeleteFomentoLabel" aria-hidden="true">
	    <div class="modal-dialog" role="document">
		    <div class="modal-content">
			    <div class="modal-header">
				    <h5 class="modal-title" id="mdDeleteFomentoLabel">
					    <i class="fa fa-trash"></i> &nbsp;&nbsp;<strong>Exclusão de Fomento</strong>
				    </h5>
			    </div>
			    <div class="modal-body">
				    <div class="modal-icon">
					    <i class="fa fa-question-circle"></i>
				    </div>
				    <div class="modal-text">
					    <input type="hidden" id="deleteFomentoId" />
					    <p class="mb-0">Tem certeza que deseja <b>excluir</b> esse registro?</p>
				    </div>
				    <div class="modal-wrapper">
				    </div>
			    </div>
			    <div class="modal-footer">
				    <button type="submit" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-thumbs-o-down"></i> &nbsp;&nbsp;Não</button>
				    <a id="deleteFomentoHref" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-thumbs-o-up"></i> &nbsp;&nbsp;Sim</a>
			    </div>
		    </div>
	    </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdVincularLocalidades" role="dialog" aria-labelledby="mdVincularLocalidadesLabel" aria-hidden="true">
	    <div class="modal-dialog" role="document">
		    <div class="modal-content">
			    <div class="modal-header">
				    <h5 class="modal-title" id="mdVincularLocalidadesLabel">
					    <i class="fa fa-link"></i> &nbsp;&nbsp;<strong>Vincular Localidades</strong>
				    </h5>
			    </div>
			    @using (@Html.BeginForm("VincularLocalidades", "Fomento", FormMethod.Post, new { id = "formVincularLocalidades", @class = "form-horizontal" }))
			    {
				    <input type="hidden" name="fomentoId" :value="editDto.FomentoId" />

				    <div class="modal-body">
					    <div class="form-group row">
						    <label class="col-sm-2 control-label text-sm-right pt-2">Estado <span class="required">*</span></label>
						    <div class="col-md-9">
                                <select class="form-control populate select2" name="ddlEstadoVincularLocalidades" id="ddlEstadoVincularLocalidades"
							            title="Por favor informe o estado." required style="width: 100%"
							            asp-for="EstadoId" asp-items="Model.ListEstados">
								    <option value="">Selecionar Estado</option>
							    </select>
						    </div>
					    </div>

                        <div class="form-group row">
						    <label class="col-sm-2 control-label text-sm-right pt-2">Municipio <span class="required">*</span></label>
						    <div class="col-md-9">
                                <select class="form-control populate select2" name="ddlMunicipioVincularLocalidades" id="ddlMunicipioVincularLocalidades"
                                        title="Por favor informe o municipio." required style="width: 100%"
							            asp-for="MunicipioId" asp-items="Model.ListMunicipios">
								    <option value="">Selecionar Municipio</option>
							    </select>
						    </div>
					    </div>
					    <div class="form-group row">
						    <label class="col-sm-2 control-label text-sm-right pt-2">Localidade <span class="required">*</span></label>
						    <div class="col-md-9">
							    <select class="form-control" multiple="multiple" data-plugin-multiselect data-plugin-options='{ "maxHeight": 300, "enableCaseInsensitiveFiltering": true }'
                                        name="ddlLocalidadeVincularLocalidades" id="ddlLocalidadeVincularLocalidades"
							            title="Por favor informe a linha de ação." required style="width:100%">
							    </select>
						    </div>
					    </div>
				    </div>
				    <div class="modal-footer">
					    <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
					    <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
				    </div>
			    }
		    </div>
	    </div>
    </div>

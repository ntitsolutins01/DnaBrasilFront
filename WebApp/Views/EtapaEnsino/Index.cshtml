@model WebApp.Models.EtapaEnsinoModel
@{
    ViewData["Title"] = "Listagem de Etapas de Ensino";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="formEtapaEnsino">
    <div class="row">
        <div class="col-lg-12">
            <section class="panel">
                <header class="panel-heading">
                    <div class="panel-actions">
                        <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
                    </div>
                    <h2 class="panel-title">Listagem de Etapas de Ensino</h2>
                </header>
                <div class="panel-body">
                    <div class="form-group row">
                        <div class="col-sm-12 pull-right">
                            <a href="@Url.Action("Create", "EtapaEnsino")" id="addToTable"
                                class="btn btn-primary pull-right"><i class="fa fa-plus"></i> Nova Etapa de Ensino </a>
                        </div>
                    </div>
                    <table class="table table-bordered table-striped mb-0" id="datatable-default">
                        <thead>
                            <tr>
                                <th class="text-center">Id</th>
                                <th class="text-center">Nome da Etapa de Ensino</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.EtapasEnsino)
                            {
                                <tr>
                                    <td class="text-center" style="width:20px;">@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Nome)</td>
                                    @if (item.Status)
                                    {
                                        <td class="text-center"><span class="label label-success">ATIVO</span></td>
                                    }
                                    else
                                    {
                                        <td class="text-center"><span class="label label-danger">INATIVO</span></td>
                                    }
                                    <td class="actions text-center">
                                        <a data-toggle="tooltip" data-placement="top" title="Editar"
                                            href='javascript:(crud.EditModal(@item.Id))' class="on-default edit-row"
                                            style='color: #FF9800'>
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" title="Excluir"
                                            href='javascript:(crud.DeleteModal(@item.Id))' class="on-default remove-row"
                                            style="cursor: pointer;color: #F44336"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdDeleteEtapaEnsino" tabindex="-1" role="dialog"
        aria-labelledby="mdDeleteEtapaEnsinoLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdDeleteEtapaEnsinoLabel">
                        <i class="fa fa-trash"></i> &nbsp;&nbsp;<strong>Exclusão de Série</strong>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="modal-icon">
                        <i class="fa fa-question-circle"></i>
                    </div>
                    <div class="modal-text">
                        <input type="hidden" id="deleteEtapaEnsinoId" />
                        <p class="mb-0">Tem certeza que deseja <b>excluir</b> esse registro?</p>
                    </div>
                    <div class="modal-wrapper">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger pull-right" style="margin-left: 5px;"
                        data-dismiss="modal"><i class="fa fa-thumbs-o-down"></i> &nbsp;&nbsp;Não</button>
                    <a id="deleteEtapaEnsinoHref" class="btn btn-success pull-right" style="margin-left: 5px;"><i
                            class="fa fa-thumbs-o-up"></i> &nbsp;&nbsp;Sim</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdEditEtapaEnsino" tabindex="-1" role="dialog" aria-labelledby="mdEditEtapaEnsinoLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdEditEtapaEnsinoLabel">
                        <i class="fa fa-pencil"></i> &nbsp;&nbsp;<strong>Alterar Etapa de Ensino</strong>
                    </h5>
                </div>
                @using (@Html.BeginForm("Edit", "EtapaEnsino", FormMethod.Post, new
                {
                    id = "formEditEtapaEnsino",
                    @class
                                = "form-horizontal"
                }))
                {
                    <input type="hidden" name="id" :value="editDto.Id" />

                    <div class="modal-body">
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Nome <span
                                    class="required">*</span></label>
                            <div class="col-sm-9">
                                <input type="text" name="nome" class="form-control" maxlength="150" :value="editDto.Nome"
                                    title="Por favor informe o nome da Etapa de Ensino." required />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Status</label>
                            <div class="col-md-3">
                                <div class="switch switch-sm switch-primary">
                                    <div v-show="editDto.Status">
                                        <input type="checkbox" id="editStatus" name="status" data-plugin-ios-switch
                                            checked="checked" />
                                    </div>
                                    <div v-show="!editDto.Status">
                                        <input type="checkbox" id="editStatus" name="status" data-plugin-ios-switch />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;"
                            data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
                        <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i
                                class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/datatables/media/css/dataTables.bootstrap4.css" />
}
@section Scripts {
    <script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
    <script src="~/assets/vendor/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/ios7-switch/ios7-switch.js"></script>
    <script src="~/assets/vendor/datatables/media/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/formatTable.js"></script>
    <script src="~/js/EtapaEnsino.js"></script>

    <script>

        (function ($) {

            'use strict';
            var crud = @ViewBag.CrudMessage;

            if (crud === 1) {
                new PNotify({
                    title: 'Etapa de Ensino',
                    text: 'Cadastro realizado com sucesso!',
                    type: 'success'
                });
                crud = 0;
            } else if (crud === 2) {
                new PNotify({
                    title: 'Etapa de Ensino',
                    text: 'Dados alterados com sucesso.',
                    type: 'warning',
                    icon: 'fa fa-pencil'
                });
                crud = 0;
            } else if (crud === 3) {
                new PNotify({
                    title: 'Etapa de Ensino',
                    text: 'Registro excluído com sucesso.',
                    type: 'error',
                    icon: 'fa fa-trash-o'
                });
                crud = 0;
            }


            var notify = @ViewBag.NotifyMessage;
            var messagem = '@ViewBag.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'Etapa de Ensino',
                    text: messagem,
                    type: 'success'
                });
                crud = 0;
            } else if (notify === 1) {
                new PNotify({
                    title: 'Etapa de Ensino',
                    text: messagem,
                    type: 'warning'
                });
                crud = 0;
            } else if (notify === 2) {
                new PNotify({
                    title: 'Etapa de Ensino',
                    text: messagem,
                    type: 'error'
                });
                crud = 0;
            }

            if ($.isFunction($.fn['tooltip'])) {
                $('[data-toggle=tooltip],[rel=tooltip]').tooltip({ container: 'body' });
            }

        }).apply(this, [jQuery]);
    </script>
}
@model WebApp.Models.EstruturaCursoModel

<div class="dd" id="nestable">
    <ol class="dd-list">
        @{
            int posicaoModulo = 1;
        }
        @foreach (var modulo in Model.ModulosEad.OrderBy(m => m.Ordem))
        {
            <li class="dd-item" data-id="modulo_@modulo.Id">
                <div class="dd-handle">
                    <span class="position-badge">@posicaoModulo</span>
                    @modulo.Titulo
                </div>
                <ol class="dd-list">
                    @{
                        int posicaoAula = 1;
                    }
                    @foreach (var aula in Model.Aulas.Where(a => a.ModuloEadId == modulo.Id).OrderBy(a => a.Ordem))
                    {
                        <li class="dd-item" data-id="aula_@aula.Id">
                            <div class="dd-handle">
                                <span class="position-badge">@posicaoModulo.@posicaoAula</span>
                                @aula.Titulo
                            </div>
                        </li>
                        posicaoAula++;
                    }
                </ol>
            </li>
            posicaoModulo++;
        }
    </ol>
</div>

<style>
    .position-badge {
        background: #007bff;
        color: white;
        border-radius: 50%;
        width: 25px;
        height: 25px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
    }
</style>

@if (!Model.ModulosEad.Any())
{
    <div class="alert alert-warning">Nenhum módulo encontrado para este curso</div>
}
@using WebApp.Dto
@model AlunoCursoCertificadoModel

<div class="row">
	<div class="col-sm-6">
		<div class="form-group">
			<label class="control-label">Carga Horária</label>
			<input type="text" name="firstname" class="form-control" value="@Model.Curso.CargaHoraria h" readonly>
		</div>
	</div>
	<div class="col-sm-6">
		<div class="form-group">
			<label class="control-label">Certificado</label>
			<input type="text" name="lastname" class="form-control" value="SIM" readonly>
		</div>
	</div>
</div>
<br/>
<div class="row">
	<div class="col-sm-6">
		<div class="form-group">
			<label class="control-label">Tipo Curso</label>
			<input type="email" name="email" class="form-control" value="@Model.Curso.TituloTipoCurso" readonly>
		</div>
	</div>
	<div class="col-sm-6">
		<div class="form-group">
			<label class="control-label">Curso</label>
			<input type="email" name="email" class="form-control" value="@Model.Curso.Titulo" readonly>
		</div>
	</div>
	@* <div class="col-sm-6">
		<div class="form-group">
			<label class="control-label">Avaliação</label><br />
			<i class="fa fa-star"></i>
			<i class="fa fa-star"></i>
			<i class="fa fa-star"></i>
			<i class="fa fa-star"></i>
			<i class="fa fa-star"></i>
		</div>
	</div> *@
</div>
<br/>
<div class="row">
	<div class="col-sm-12">
		<div class="form-group">
			<label class="control-label">Descrição do Curso</label>
			<textarea type="descricao" name="descricao" class="form-control"  readonly rows="4">@Model.Curso.Descricao</textarea>
		</div>
	</div>
</div>
<br />
<div class="row">
	<div class="col-sm-12">
		<div class="panel panel-default form-group">
			<label class="control-label">Conteúdo</label>
			<div class="panel-body" style="background: #eee;">
				<div class="panel-group" id="accordion">
					@if (Model.Modulos != null && Model.Modulos.Any())
					{
						foreach (var modulo in Model.Modulos)
						{
							var moduloAulas = Model.Aulas?.Where(a => a.ModuloEadId == modulo.Id).OrderBy(a => a.Ordem).ToList()
							?? new List<AulaDto>();
							var collapseId = "collapseModulo" + modulo.Id;
							var isExpanded = modulo.Equals(Model.Modulos.First()) ? "in" : "";
							<div class="panel panel-accordion">
								<div class="panel-heading">
									<h4 class="panel-title">
										<a class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#@collapseId">
											<i class="fa fa-folder-o mr-xs"></i> @modulo.Titulo
										</a>
									</h4>
								</div>
								<div id="@collapseId" class="accordion-body collapse @isExpanded">
									<div class="panel-body">
										@if (moduloAulas.Any())
										{
											<ul class="nav nav-list">
												@foreach (var aula in moduloAulas)
												{
													<li class="mb-sm">
														<i class="fa fa-video-camera"></i>  -  @aula.Titulo
													</li>
													<li class="mb-sm">
														<i class="fa fa-file-pdf-o"></i>  -  @aula.NomeMaterial
													</li>
												}
											</ul>
										}
										else
										{
											<p>Nenhuma aula disponível para este módulo.</p>
										}
									</div>
								</div>
							</div>
						}
					}
					else
					{
						<p>Nenhum módulo encontrado.</p>
					}
				</div>

			</div>
		</div>
	</div>
</div>
<!-- Módulos e Aulas -->

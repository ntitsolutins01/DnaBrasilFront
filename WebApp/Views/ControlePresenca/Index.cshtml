@using WebApp.Enumerators
@model WebApp.Models.ControlePresencaModel
@{
    ViewData["Title"] = "Listagem de ControlePresencas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="vControlePresenca">
    @using (@Html.BeginForm("Index", "ControlePresenca", FormMethod.Post, new { id = "formControlePresencas", @class = "form-horizontal" }))
    {
        <div class="row">
            <div class="col-md-12">
                <section class="panel">
                    <header class="panel-heading">
                        <div class="panel-actions">
                            <a href="#" class="panel-action panel-action-toggle" data-panel-toggle></a>
                        </div>
                        <h2 class="panel-title">Filtro de pesquisa</h2>
                    </header>
                    <div class="panel-body">
                        <label class="col-sm-2 control-label">Estado:</label>
                        <div class="col-md-4 form-group">
                            @{

                                if (Model.IdPerfil == (int)EnumPerfil.Administrador)
                                {
                                    <select class="form-control populate select2" name="ddlEstado" id="ddlEstado" style="width: 100%"
                                            asp-for="EstadoId" asp-items="Model.ListEstados">
                                        <option value="">Selecionar Estado</option>
                                    </select>
                                }
                                else
                                {
                                    <select class="form-control populate select2" name="ddlEstado" id="ddlEstado" style="width: 100%" disabled="disabled"
                                            asp-for="EstadoId" asp-items="Model.ListEstados">
                                        <option value="">Selecionar Estado</option>
                                    </select>
                                }
                            }
                        </div>
                        <label class="col-sm-2 control-label">Municipio:</label>
                        <div class="col-md-4 form-group">
                            @{
                                if (Model.IdPerfil == (int)EnumPerfil.Administrador)
                                {
                                    <select class="form-control populate select2" name="ddlMunicipio" id="ddlMunicipio" style="width: 100%"
                                            asp-for="MunicipioId" asp-items="Model.ListMunicipios">
                                        <option value="">Selecionar Municipio</option>
                                    </select>
                                }
                                else
                                {
                                    if (Model.IdPerfil == (int)EnumPerfil.GestorPedagogico)
                                    {
                                        <select class="form-control populate select2" name="ddlMunicipio" id="ddlMunicipio" style="width: 100%"
                                                asp-for="MunicipioId" asp-items="Model.ListMunicipios">
                                            <option value="">Selecionar Municipio</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select class="form-control populate select2" name="ddlMunicipio" id="ddlMunicipio" style="width: 100%" disabled="disabled"
                                                asp-for="MunicipioId" asp-items="Model.ListMunicipios">
                                            <option value="">Selecionar Municipio</option>
                                        </select>
                                    }
                                }
                            }
                        </div>
                        <label class="col-sm-2 control-label">Localidade:</label>
                        <div class="col-md-4 form-group">
                            @{
                                if (Model.IdPerfil == (int)EnumPerfil.Administrador)
                                {
                                    <select class="form-control populate select2" name="ddlLocalidade" id="ddlLocalidade" style="width: 100%"
                                            asp-for="LocalidadeId" asp-items="Model.ListLocalidades">
                                        <option value="">Selecionar Localidade</option>
                                    </select>
                                }
                                else
                                {
                                    if (Model.IdPerfil == (int)EnumPerfil.GestorPedagogico)
                                    {
                                        <select class="form-control populate select2" name="ddlLocalidade" id="ddlLocalidade" style="width: 100%"
                                                asp-for="LocalidadeId" asp-items="Model.ListLocalidades">
                                            <option value="">Selecionar Localidade</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select class="form-control populate select2" name="ddlLocalidade" id="ddlLocalidade" style="width: 100%" disabled="disabled"
                                                asp-for="LocalidadeId" asp-items="Model.ListLocalidades">
                                            <option value="">Selecionar Localidade</option>
                                        </select>
                                    }


                                }
                            }
                        </div>
                        <label class="col-sm-2 control-label">Profissional:</label>
                        <div class="col-md-4 form-group">
                            @{
                                if (Model.IdPerfil == (int)EnumPerfil.Administrador)
                                {
                                    <select class="form-control populate select2" name="ddlProfissional" id="ddlProfissional"
                                            title="Por favor informe o profissional." style="width: 100%"
                                            asp-for="ProfissionalId" asp-items="Model.ListProfissionais">
                                        <option value="">Selecionar Profissional</option>
                                    </select>
                                }
                                else
                                {
                                    if (Model.IdPerfil == (int)EnumPerfil.GestorPedagogico || Model.IdPerfil == (int)EnumPerfil.Coordenador)
                                    {
                                        <select class="form-control populate select2" name="ddlProfissional" id="ddlProfissional"
                                                title="Por favor informe o profissional." style="width: 100%"
                                                asp-for="ProfissionalId" asp-items="Model.ListProfissionais">
                                            <option value="">Selecionar Profissional</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select class="form-control populate select2" name="ddlProfissional" id="ddlProfissional" disabled="disabled"
                                                title="Por favor informe o profissional." style="width: 100%"
                                                asp-for="ProfissionalId" asp-items="Model.ListProfissionais">
                                            <option value="">Selecionar Profissional</option>
                                        </select>
                                    }

                                }
                            }
                        </div>
                        <label class="col-sm-2 control-label">Atividade / Modalidade:</label>
                        <div class="col-sm-4 form-group">
                            <select class="form-control populate select2" name="ddlModalidade" id="ddlModalidade"
                                    title="Por favor informe a Atividade / Modalidade." required style="width:100%"
                                    asp-for="AtividadeModalidadeId" asp-items="Model.ListAtividadesModalidades">
                                <option value="">Selecionar Atividade / Modalidade</option>
                            </select>
                        </div>
                        <label class="col-sm-2 control-label text-sm-right pt-2">Turma:</label>
                        <div class="col-md-4 form-group">
                            <select class="form-control populate select2" name="ddlTurma" id="ddlTurma"
                                    title="Por favor informe a turma." required style="width:100%"
                                    asp-for="TurmaId" asp-items="Model.ListTurmas">
                                <option value="">Selecionar Turma</option>
                            </select>
                        </div>
                        <label class="col-sm-2 control-label">Estrutura </label>
                        <div class="col-sm-4 form-group">
                            <input id="estrutura" name="estrutura" readonly="readonly"
                                   type="text" class="form-control" value="@Model.Estrutura"
                                   maxlength="14" />
                        </div>
                        <label class="col-sm-2 control-label">Dias da Semana </label>
                        <div class="col-sm-4 form-group">
                            <input id="diaSemana" name="diaSemana" readonly="readonly"
                                   type="text" class="form-control" value="@Model.DiasSemana"
                                   maxlength="14" />
                        </div>
                        <label class="col-sm-2 control-label">Categoria </label>
                        <div class="col-sm-4 form-group">
                            <input id="categoria" name="categoria" value="@Model.Categoria"
                                   type="text" class="form-control" readonly="readonly"
                                   maxlength="14" />
                        </div>
                        <label class="col-sm-2 control-label">Data: <span class="required">*</span></label>
                        <div class="col-sm-4 form-group">
                            <div class="input-group">
                                <span class="input-group-addon">
                                    <i class="fa fa-calendar"></i>
                                </span>
                                <input id="data" name="data"
                                       required
                                       title="Por favor informe a data."
                                       style="z-index: auto;" value="@Model.Data"
                                       data-plugin-datepicker data-date-format="dd/mm/yyyy" data-plugin-options='{"language": "pt-BR"}'
                                       placeholder="__/__/____" class="form-control startdate"
                                       class="form-control">
                            </div>
                        </div>
                    </div>
                    <footer class="panel-footer">
                        <div class="form-group row">
                            <div class="col-sm-7 pull-left">
                                <div class="alert alert-info" style="padding-bottom: 6px;padding-top: 6px; !important; margin-bottom: 0px; !important">
                                    <strong>Info: </strong> Impressão de controle de frequência em lote selecione o filtro e clique em
                                    <a href="" class="alert-link">Imprimir Controle Frequência</a>.
                                </div>
                            </div>
                            <div class="col-sm-3 pull-right">
                                <a href="#" id="btnImprimirLaudo" class="btn btn-block btn-dark pull-right" data-toggle="modal" data-target="#mdMesImpressao">
                                    <i class="fa fa-print"></i> &nbsp;&nbsp;Imprimir Controle Presença
                                </a>
                            </div>
                        </div>
                    </footer>
                </section>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-12">
                <section class="panel">
                    <header class="panel-heading">
                        <div class="panel-actions">
                            <a href="#" class="card-action card-action-toggle" data-card-toggle></a>
                        </div>
                        <h2 class="panel-title">Listagem de Controles de Presenças</h2>
                    </header>
                    <div class="panel-body">
                        <table class="adicionados table table-bordered table-striped mb-0" id="alunoDataTable" name="alunoDataTable">
                            <thead>
                                <tr>
                                    <th class="text-center">Falta</th>
                                    <th class="text-center">Nome Aluno</th>
                                    <th class="text-center">Justificativa</th>
                                </tr>
                            </thead>
                            @if (Model.ListAtividadeAlunos != null)
                            {
                                <tbody>
                                    @foreach (var item in Model.ListAtividadeAlunos)
                                    {
                                        <tr>
                                            <td class="text-center" style="width:10%;">
                                                <div class='switch switch-sm switch-success'>
                                                    <input type='checkbox' id='habilitado' name='habilitado' data-plugin-ios-switch />
                                                </div>
                                            </td>
                                            <td class="text-center" style="width:50%;">@Html.DisplayFor(modelItem => item.AlunoId) - @Html.DisplayFor(modelItem => item.Nome)</td>
                                            <td class="text-center" style="width:40%;">
                                                <div class='input-group input-group-icon'>
                                                    <textarea id='falta' name='falta-@Html.DisplayFor(modelItem => item.AlunoId)' rows='1' class='form-control form-control-lg'></textarea>
                                                </div>"
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                        @* <table class="table table-bordered table-striped mb-0" id="datatable-default">
                        <thead>
                            <tr>
                                <th class="text-center">Id</th>
                                <th class="text-center">Aluno</th>
                                <th class="text-center">Localidade</th>
                                <th class="text-center" style="width: 10%;">Controle</th>
                                <th class="text-center">Data</th>
                                <th class="text-center">Justificativa</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ControlesPresencas.Items)
                            {
                                <tr>
                                    <td class="text-center" style="width:20px;">@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.NomeAluno)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.NomeLocalidade)</td>
                                    @if (item.Controle == "P")
                                    {
                                        <td class="text-center"><span class="label label-success" style="display: block;">Presente</span></td>
                                    }
                                    else
                                    {
                                        <td class="text-center"><span class="label label-danger" style="display: block;">Falta</span></td>
                                    }
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Data)</td>
                                    <td class="text-center">@Html.DisplayFor(modelItem => item.Justificativa)</td>
                                    <td class="actions text-center">
                                        <a data-toggle="tooltip" data-placement="top" title="Editar"
                                           href='javascript:(crud.EditModal(@item.Id))'
                                           class="on-default edit-row" style='color: #FF9800' style="display: block;">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a data-toggle="tooltip" 
                                           data-target="#mdMesImpressao" 
                                           data-placement="top"
                                           data-id="@item.Id"
                                           title="Imprimir Frequência"
                                           class="on-default edit-row"
                                           href="javascript:void(0);"
                                           onclick="crud.ImprimirFrequencia(@item.Id)" @*Trocar por alunoId depois
                                           style="color: #212121; cursor: pointer;">
                                            <i class="fa fa-print"></i>
                                        </a>
                                        <a data-toggle="tooltip" data-placement="top" title="Excluir" href='javascript:(crud.DeleteModal(@item.Id))'
                                           class="on-default remove-row" style=" cursor: pointer;color: #F44336"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table> *@
                    </div>
                    <footer class="panel-footer">
                        <div class="row">
                            <div class="col-md-9 col-md-offset-3">
                                <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
                                <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
                            </div>
                        </div>
                    </footer>
                </section>
            </div>
        </div>
    }
    <!-- Modal -->
    <div class="modal fade" id="mdDeleteControlePresenca" tabindex="-1" role="dialog" aria-labelledby="mdDeleteControlePresencaLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdDeleteControlePresencaLabel">
                        <i class="fa fa-trash"></i> &nbsp;&nbsp;<strong>Exclusão de ControlePresenca</strong>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="modal-icon">
                        <i class="fa fa-question-circle"></i>
                    </div>
                    <div class="modal-text">
                        <input type="hidden" id="deleteControlePresencaId" />
                        <p class="mb-0">Tem certeza que deseja <b>excluir</b> esse registro?</p>
                    </div>
                    <div class="modal-wrapper">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-thumbs-o-down"></i> &nbsp;&nbsp;Não</button>
                    <a id="deleteControlePresencaHref" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-thumbs-o-up"></i> &nbsp;&nbsp;Sim</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdEditControlePresenca" tabindex="-1" role="dialog" aria-labelledby="mdEditControlePresencaLabel" aria-hidden="true">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdEditControlePresencaLabel">
                        <i class="fa fa-pencil"></i> &nbsp;&nbsp;<strong>Alterar ControlePresenca</strong>
                    </h5>
                </div>
                @using (@Html.BeginForm("Edit", "ControlePresenca", FormMethod.Post, new { id = "formEditControlePresenca", @class = "form-horizontal" }))
                {
                    <input type="hidden" name="editControlePresencaId" :value="editDto.Id" />
                    <input type="hidden" name="editAlunoId" :value="editDto.AlunoId" />

                    <div class="modal-body">
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Município / UF</label>
                            <div class="col-sm-5">
                                <input type="text" name="municipio" class="form-control" :value="editDto.MunicipioEstado" readonly />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Localidade</label>
                            <div class="col-sm-9">
                                <input type="text" name="localidade" class="form-control" :value="editDto.NomeLocalidade" readonly />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Aluno <span class="required">*</span></label>
                            <div class="col-md-9">
                                <input type="text" name="aluno" class="form-control" :value="editDto.NomeAluno" readonly />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Controle <span class="required">*</span></label>
                            <div class="col-sm-4">
                                <div class="radio-custom radio-success">
                                    <input type="radio" id="controlePresente" name="controle" value="P" required title="Por favor selecione uma opção" :checked="editDto.Controle === 'P'">
                                    <label>Presente</label>
                                </div>
                                <div class="radio-custom radio-danger">
                                    <input type="radio" id="controleFalta" name="controle" value="F" required title="Por favor selecione uma opção" :checked="editDto.Controle === 'F'">
                                    <label>Falta</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label text-sm-right pt-2">Justificativa <span class="required">*</span></label>
                            <div class="col-sm-9">
                                <textarea class="form-control" rows="3" maxlength="500" :value="editDto.Justificativa" name="justificativa"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="reset" class="btn btn-danger pull-right" style="margin-left: 5px;" data-dismiss="modal"><i class="fa fa-remove"></i> &nbsp;&nbsp;Cancelar</button>
                        <button type="submit" class="btn btn-success pull-right" style="margin-left: 5px;"><i class="fa fa-save"></i> &nbsp;&nbsp;Salvar</button>
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="mdMesImpressao" tabindex="-1" role="dialog" aria-labelledby="mdMesImpressaoLabel" aria-hidden="true">
        <div class="modal-dialog modal-md" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="mdMesImpressaoLabel">
                        <i class="fa fa-print"></i> &nbsp;&nbsp;<strong>Impressão controle de frequência</strong>
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                @using (@Html.BeginForm("ImprimirFrequencia", "ControlePresenca", FormMethod.Post, new { id = "formImprimir", @class = "form-horizontal" }))
                {
                    <div class="modal-body">
                        <input type="hidden" id="itemId" name="itemId" />
                        <input type="hidden" id="alunoId" name="alunoId" />
                        <div class="form-group">
                            <label class="col-sm-3 control-label text-sm-right pt-2">
                                Mês <span class="required text-danger">*</span>
                            </label>
                            <div class="col-md-8">
                                <select class="form-control populate select2"
                                        name="ddlMes"
                                        id="ddlMes"
                                        style="width:100%"
                                        title="Por favor informe o mês."
                                        required>
                                    <option value="">Selecionar Mês</option>
                                    <option value="1">Janeiro</option>
                                    <option value="2">Fevereiro</option>
                                    <option value="3">Março</option>
                                    <option value="4">Abril</option>
                                    <option value="5">Maio</option>
                                    <option value="6">Junho</option>
                                    <option value="7">Julho</option>
                                    <option value="8">Agosto</option>
                                    <option value="9">Setembro</option>
                                    <option value="10">Outubro</option>
                                    <option value="11">Novembro</option>
                                    <option value="12">Dezembro</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid #dee2e6; padding: 1rem;">
                        <div class="w-100">
                            <div class="col-12 text-right">
                                <button type="reset"
                                        class="btn btn-danger"
                                        data-dismiss="modal"
                                        style="margin-right: 10px;">
                                    <i class="fa fa-times"></i> &nbsp;Cancelar
                                </button>
                                <button type="button"
                                        class="btn btn-success"
                                        onclick="submitForm()">
                                    <i class="fa fa-print"></i> &nbsp;Imprimir
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section CssSpecificVendor {
    <link rel="stylesheet" href="~/assets/vendor/select2/css/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/select2-bootstrap-theme/select2-bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/datatables/media/css/dataTables.bootstrap4.css" />
    <link href="~/assets/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.css" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets/vendor/jquery-validation/jquery.validate.js"></script>
    <script src="~/assets/vendor/select2/js/select2.js"></script>
    <script src="~/assets/vendor/datatables/media/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/vendor/datatables/media/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/assets/vendor/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/assets/vendor/bootstrap-datepicker/locales/bootstrap-datepicker.pt-BR.min.js"></script>
    <script src="~/js/ControlesPresencas.js"></script>

    <script>

        (function ($) {

            'use strict';
            var crud = @ViewBag.CrudMessage;

            if (crud === 1) {
                new PNotify({
                    title: 'Controle de Presenca',
                    text: 'Cadastro realizado com sucesso!',
                    type: 'success'
                });
                crud = 0;
            } else if (crud === 2) {
                new PNotify({
                    title: 'ControlePresenca',
                    text: 'Dados alterados com sucesso.',
                    type: 'warning',
                    icon: 'fa fa-pencil'
                });
                crud = 0;
            } else if (crud === 3) {
                new PNotify({
                    title: 'ControlePresenca',
                    text: 'Registro excluído com sucesso.',
                    type: 'error',
                    icon: 'fa fa-trash-o'
                });
                crud = 0;
            }


            var notify = @ViewBag.NotifyMessage;
            var messagem = '@ViewBag.Notify';

            if (notify === 0) {
                new PNotify({
                    title: 'ControlePresenca',
                    text: messagem,
                    type: 'success'
                });
                crud = 0;
            } else if (notify === 1) {
                new PNotify({
                    title: 'ControlePresenca',
                    text: messagem,
                    type: 'warning'
                });
                crud = 0;
            } else if (notify === 2) {
                new PNotify({
                    title: 'ControlePresenca',
                    text: messagem,
                    type: 'error'
                });
                crud = 0;
            }

            if ($.isFunction($.fn['tooltip'])) {
                $('[data-toggle=tooltip],[rel=tooltip]').tooltip({ container: 'body' });
            }

        }).apply(this, [jQuery]);


                // Gerenciamento do modal
        $(document).ready(function() {
            // Inicializa tooltips
            $('[data-toggle="tooltip"]').tooltip({
                container: 'body'
            });

            // Handler do modal
            $('#mdMesImpressao').on('show.bs.modal', function (event) {
                // Limpa o select de mês quando o modal abre
                $('#ddlMes').val('').trigger('change');

                // Pega o ID do botão que foi clicado
                var button = $(event.relatedTarget);
                var itemId = button.data('id');

                if (itemId) {
                    $('#itemId').val(itemId);
                    // Se veio da tabela, preenche o ID do aluno se necessário
                    var alunoId = $('input[name="editAlunoId"]').val();
                    $('#alunoId').val(alunoId);
                }
            });

            // Handler do submit do form
            $('#formImprimir').on('submit', function(e) {
                e.preventDefault();

                var itemId = $('#itemId').val();
                var mes = $('#ddlMes').val();

                if (!mes) {
                    new PNotify({
                        title: 'Atenção',
                        text: 'Por favor, selecione um mês.',
                        type: 'warning'
                    });
                    return false;
                }

                if (itemId) {
                    // Impressão individual
                    vm.handlePrintSubmit(itemId, mes);
                } else {
                    // Impressão em lote
                    this.submit();
                }
            });

            // Limpa os campos quando o modal fecha
            $('#mdMesImpressao').on('hidden.bs.modal', function () {
                $('#itemId').val('');
                $('#alunoId').val('');
                $('#ddlMes').val('').trigger('change');
            });
        });
    </script>
}



